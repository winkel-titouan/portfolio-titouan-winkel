---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import SkewButton from "../../components/SkewButton.astro";
import ContactCta from "../../components/ContactCta.astro";
import { supabase, getFileUrl, type Projet } from "../../utils/supabase";

const { id = "" } = Astro.params;

let project: Projet;
let allProjects: Pick<Projet, "id" | "nom" | "created_at">[] = [];
try {
	const [one, all] = await Promise.all([
		supabase.from("projets").select("*").eq("id", id).single(),
		supabase.from("projets").select("id, nom, created_at").order("created_at"),
	]);
	if (one.error) throw one.error;
	if (all.error) throw all.error;
	[project, allProjects] = [one.data, all.data];
} catch (error) {
	console.error(`Projet introuvable (${id}) :`, error);
	return Astro.redirect("/projets");
}

// Couleur du projet (certaines sont saisies sans « # ») et couleur de texte lisible dessus
const rawColor = (project.couleur || "").trim().replace(/^#?/, "#");
const projectColor = /^#[0-9a-f]{6}$/i.test(rawColor) ? rawColor : "#a983e2";
const [r, g, b] = [1, 3, 5].map((i) => parseInt(projectColor.slice(i, i + 2), 16) / 255);
const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
const onColor = luminance > 0.5 ? "#0b0710" : "#ffffff";

// Position dans la liste (ordre chronologique) pour la numérotation et la navigation
const position = allProjects.findIndex((p) => p.id === project.id);
const prevProject = position > 0 ? allProjects[position - 1] : undefined;
const nextProject = position >= 0 && position < allProjects.length - 1 ? allProjects[position + 1] : undefined;
const number = String(position + 1).padStart(2, "0");
const total = String(allProjects.length).padStart(2, "0");
const year = project.created_at ? new Date(project.created_at).getFullYear() : undefined;

const file = (name: string) => getFileUrl(project.id, name);
const finals = (project.visuels ?? []).map(file);
const inspirations = (project.inspirations_images ?? []).map(file);
const logoUrl = project.logo_apres ? file(project.logo_apres) : undefined;
const siteUrl = project.lien_site;

// Taille de départ du titre (la police fait environ 1em par lettre), affinée ensuite en JS pour tenir dans le hero
const name = project.nom;
const longestWord = Math.max(...name.split(" ").map((w) => w.length));
const fitLength = name.length <= 12 ? name.length : longestWord;
const titleSize = Math.min(20, 86 / Math.max(fitLength, 1)).toFixed(2);

// Emplacements du moodboard (centre en %, rotation en degrés), réutilisés en boucle
const spots = [
	[20, 30, -8],
	[79, 26, 6],
	[30, 74, 5],
	[71, 73, -6],
	[50, 20, 3],
	[11, 58, 7],
	[90, 55, -4],
	[52, 84, -3],
];
const chapterInspi = "01";
const chapterFinals = inspirations.length > 0 ? "02" : "01";
---

<Layout title={`${name} - Titouan Winkel`} description={project.description || undefined}>
	<main class="project overflow-x-clip" style={`--p: ${projectColor}; --p-on: ${onColor};`}>
		<!-- HERO : couleur du projet, logo dans un disque, nom en très grand -->
		<section class="hero">
			<div class="hero-bg" aria-hidden="true"></div>

			<div class="hero-top container mx-auto px-4 md:px-6">
				<a href="/projets" class="back-link">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="square"></path>
					</svg>
					Tous les projets
				</a>
				<p class="hero-meta">
					<span>Projet {number} / {total}</span>
					{year && <span>{year}</span>}
				</p>
			</div>

			<div class="hero-center">
				<div class="hero-disc-wrap">
					<span class="hero-disc" aria-hidden="true"></span>
					{
						logoUrl ? (
							<img class="hero-logo" src={logoUrl} alt={`Logo ${name}`} fetchpriority="high" />
						) : (
							<span class="hero-logo hero-initial" aria-hidden="true">{name.charAt(0)}</span>
						)
					}
				</div>

				<h1 class="hero-title" style={`--title-size: ${titleSize}vw`} aria-label={name}>
					{
						name.split(" ").map((word) => (
							<span class="word" aria-hidden="true">
								{[...word].map((char) => (
									<span class="char">{char}</span>
								))}
							</span>
						))
					}
				</h1>
			</div>

			<div class="hero-band" aria-hidden="true">
				<div class="hero-band-track">
					{Array.from({ length: 12 }, () => <span>{name} ✦</span>)}
				</div>
			</div>
		</section>

		<div class="story">
			<!-- CHAPITRE : INSPIRATIONS, les images arrivent une à une pour former un moodboard -->
			{
				inspirations.length > 0 && (
					<section class="chapter inspi" aria-label="Inspirations">
						<div class="inspi-stage">
							<h2 class="chapter-title inspi-title">
								<span class="chapter-num">{chapterInspi}</span>
								Inspirations
							</h2>
							<ul class="inspi-board">
								{inspirations.map((src, i) => {
									const [x, y, rot] = spots[i % spots.length];
									const shift = Math.floor(i / spots.length) * 4;
									return (
										<li class="inspi-item" style={`--x: ${x + shift}%; --y: ${y + shift}%; --r: ${rot}deg;`}>
											<a href={src} data-lightbox="inspirations" data-index={i} aria-label={`Agrandir l'inspiration ${i + 1}`}>
												<img src={src} alt={`Inspiration ${i + 1}`} decoding="async" />
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					</section>
				)
			}

			<!-- CHAPITRE : RÉALISATION, défilement horizontal des productions finales -->
			{
				finals.length > 0 && (
					<section id="realisation" class="chapter finals" aria-label="Réalisation">
						<div class="finals-stage">
							<div class="finals-track">
								<div class="finals-intro">
									<h2 class="chapter-title">
										<span class="chapter-num">{chapterFinals}</span>
										Réalisation
									</h2>
									<p class="finals-count">
										<span class="finals-count-num">{String(finals.length).padStart(2, "0")}</span>
										visuel{finals.length > 1 ? "s" : ""}
										<span class="finals-count-line" aria-hidden="true"></span>
									</p>
								</div>
								{finals.map((src, i) => (
									<a href={src} class="final-item" data-lightbox="finals" data-index={i} aria-label={`Agrandir le visuel ${i + 1}`}>
										<img src={src} alt={`${name} — visuel ${i + 1}`} decoding="async" />
									</a>
								))}
							</div>
							<div class="finals-progress" aria-hidden="true"><span></span></div>
						</div>
					</section>
				)
			}
		</div>

		<!-- FIN : lien vers le site -->
		{
			siteUrl && (
				<section class="outro">
					<p class="outro-title" data-reveal>En ligne</p>
					<div data-reveal>
						<SkewButton href={siteUrl} target="_blank" rel="noopener noreferrer" icon="arrow" variant="primary">
							Voir le site
						</SkewButton>
					</div>
				</section>
			)
		}

		<!-- NAVIGATION ENTRE PROJETS -->
		{
			(prevProject || nextProject) && (
				<nav class="container mx-auto px-4 md:px-6 pt-16 md:pt-24" aria-label="Autres projets">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal data-reveal-stagger>
						{prevProject ? (
							<a href={`/projets/${prevProject.id}`} class="project-nav">
								<span class="text-sm uppercase tracking-widest">← Projet précédent</span>
								<span class="font-heading text-2xl md:text-3xl leading-tight">{prevProject.nom}</span>
							</a>
						) : (
							<span class="hidden md:block" />
						)}
						{nextProject && (
							<a href={`/projets/${nextProject.id}`} class="project-nav project-nav--next">
								<span class="text-sm uppercase tracking-widest">Projet suivant →</span>
								<span class="font-heading text-2xl md:text-3xl leading-tight">{nextProject.nom}</span>
							</a>
						)}
					</div>
				</nav>
			)
		}

		<ContactCta />
	</main>

	<!-- Visionneuse plein écran -->
	<dialog id="lightbox" class="lightbox" aria-label="Visionneuse d'images">
		<img id="lightbox-img" alt="" />
		<p id="lightbox-count" class="lightbox-count"></p>
		<button class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Fermer">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke-linecap="square" /></svg>
		</button>
		<button class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Image précédente">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="square" /></svg>
		</button>
		<button class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Image suivante">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" /></svg>
		</button>
	</dialog>
</Layout>

<style>
	.project {
		/* Fond des chapitres : le disque du hero prend cette couleur en s'agrandissant pour faire la transition */
		--story-bg: color-mix(in srgb, var(--p) 12%, #fff);
	}

	/* ---------- HERO ---------- */
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100svh;
		min-height: 560px;
		margin-top: calc(-1 * var(--header-h));
		padding-top: var(--header-h);
		overflow: hidden;
		background: var(--p);
		color: var(--p-on);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 50% 42%, color-mix(in srgb, #fff 30%, transparent), transparent 55%),
			linear-gradient(color-mix(in srgb, var(--p-on) 10%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
			linear-gradient(90deg, color-mix(in srgb, var(--p-on) 10%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
	}

	.hero-top {
		position: relative;
		z-index: 3;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 1.5rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		background: #fff;
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.back-link svg {
		transition: transform 0.25s ease;
	}

	.back-link:hover {
		background: var(--color-ink);
		color: #fff;
	}

	.back-link:hover svg {
		transform: translateX(-4px);
	}

	.hero-meta {
		display: flex;
		gap: 10px;
		font-family: var(--font-heading);
		font-size: 0.9rem;
	}

	.hero-meta span {
		padding: 4px 12px;
		background: var(--color-ink);
		color: #fff;
		transform: skewX(-12deg);
	}

	.hero-center {
		position: relative;
		z-index: 2;
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		/* Hauteur fixée par le hero (et non par le titre) pour que l'ajustement du titre puisse la mesurer */
		min-height: 0;
		padding-inline: 4vw;
	}

	.hero-disc-wrap {
		position: relative;
		display: grid;
		place-items: center;
		width: clamp(130px, 22svh, 240px);
		aspect-ratio: 1;
		margin-bottom: -0.6rem;
	}

	/* Le disque s'agrandit au défilement jusqu'à couvrir tout l'écran */
	.hero-disc {
		position: absolute;
		inset: 0;
		z-index: 0;
		border: 4px solid var(--color-ink);
		border-radius: 9999px;
		background: var(--story-bg);
		box-shadow: 8px 8px 0 0 var(--color-ink);
	}

	.hero-logo {
		position: relative;
		z-index: 1;
		max-width: 62%;
		max-height: 62%;
		object-fit: contain;
	}

	.hero-initial {
		font-family: var(--font-heading);
		font-size: clamp(4rem, 12svh, 8rem);
		line-height: 1;
		color: var(--color-ink);
	}

	.hero-title {
		position: relative;
		z-index: 2;
		max-width: 100%;
		font-size: min(var(--title-size), 28svh);
		line-height: 0.95;
		text-align: center;
		text-shadow: 0.045em 0.045em 0 color-mix(in srgb, var(--color-ink) 35%, transparent);
	}

	.hero-title .word {
		display: inline-flex;
		overflow: hidden;
		padding: 0 0.06em 0.1em;
		margin-right: 0.2em;
	}

	.hero-title.is-ready .word {
		overflow: visible;
	}

	.hero-title .word:last-child {
		margin-right: 0;
	}

	.hero-title .char {
		display: inline-block;
	}

	/* Bandeau incliné qui répète le nom du projet en continu */
	.hero-band {
		position: relative;
		z-index: 3;
		margin: 0 -2vw 3.5rem;
		padding: 14px 0;
		border-block: 4px solid var(--color-ink);
		background: var(--color-ink);
		color: var(--p);
		transform: rotate(-2deg);
		overflow: hidden;
		white-space: nowrap;
	}

	.hero-band-track {
		display: inline-flex;
		gap: 2rem;
		font-family: var(--font-heading);
		font-size: clamp(1rem, 2.2vw, 1.6rem);
		animation: band-scroll 30s linear infinite;
	}

	@keyframes band-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	/* ---------- CHAPITRES ---------- */
	.chapter {
		position: relative;
		background: var(--story-bg);
		color: var(--color-ink);
	}

	.chapter-title {
		display: flex;
		flex-direction: column;
		font-size: min(7.2vw, 7rem);
		line-height: 0.95;
	}

	.chapter-num {
		font-size: max(0.45em, 1.5rem);
		color: transparent;
		-webkit-text-stroke: 2px var(--color-ink);
	}

	/* Inspirations : grille simple sur mobile, moodboard éparpillé sur grand écran */
	.inspi-stage {
		padding: 4rem 1rem;
	}

	.inspi-title {
		margin-bottom: 2rem;
	}

	.inspi-board {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 14px;
	}

	.inspi-item a {
		display: block;
		overflow: hidden;
		border: 3px solid var(--color-ink);
		background: #fff;
		box-shadow: var(--shadow-brutal);
		cursor: zoom-in;
	}

	.inspi-item img {
		width: 100%;
		height: auto;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.inspi-item a:hover img {
		transform: scale(1.06);
	}

	@media (min-width: 1024px) {
		.inspi-stage {
			position: relative;
			height: 100svh;
			padding: 0;
			overflow: hidden;
		}

		.inspi-title {
			position: absolute;
			top: 50%;
			left: 50%;
			z-index: 0;
			margin: 0;
			translate: -50% -50%;
			font-size: min(7vw, 9rem);
			text-align: center;
			align-items: center;
		}

		.inspi-board {
			position: absolute;
			inset: 0;
			display: block;
		}

		.inspi-item {
			position: absolute;
			top: var(--y);
			left: var(--x);
			z-index: 1;
			translate: -50% -50%;
			rotate: var(--r);
		}

		.inspi-item img {
			width: auto;
			max-width: 24vw;
			max-height: 36svh;
		}

		.inspi-item a {
			transition: box-shadow 0.3s ease;
		}

		.inspi-item a:hover {
			box-shadow: 10px 10px 0 0 var(--p);
		}
	}

	/* Réalisation : liste verticale sur mobile, piste horizontale épinglée sur grand écran */
	.finals {
		border-top: 4px solid var(--color-ink);
	}

	.finals-track {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 4rem 1rem;
	}

	/* Simple annotation (et non un bouton) : nombre de visuels suivi d'un trait fléché vers la galerie */
	.finals-count {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-top: 1.25rem;
		font-family: var(--font-heading);
		font-size: 1.1rem;
	}

	.finals-count-num {
		font-size: 2.2em;
		line-height: 1;
		color: color-mix(in srgb, var(--p) 75%, var(--color-ink));
	}

	.finals-count-line {
		display: none;
	}

	@media (min-width: 1024px) {
		.finals-count-line {
			position: relative;
			display: block;
			align-self: center;
			width: 120px;
			height: 3px;
			margin-left: 6px;
			background: var(--color-ink);
		}

		.finals-count-line::after {
			content: "";
			position: absolute;
			top: 50%;
			right: 0;
			width: 12px;
			height: 12px;
			border-top: 3px solid var(--color-ink);
			border-right: 3px solid var(--color-ink);
			transform: translateY(-50%) rotate(45deg);
		}
	}

	.final-item {
		position: relative;
		display: block;
		flex-shrink: 0;
		overflow: hidden;
		border: 4px solid var(--color-ink);
		background: #fff;
		box-shadow: 10px 10px 0 0 var(--color-ink);
		cursor: zoom-in;
	}

	.final-item img {
		width: 100%;
		height: auto;
	}


	.finals-progress {
		display: none;
	}

	@media (min-width: 1024px) {
		.finals-stage {
			position: relative;
			display: flex;
			align-items: center;
			height: 100svh;
			overflow: hidden;
		}

		.finals-track {
			flex-direction: row;
			align-items: center;
			gap: 5vw;
			padding: 0 8vw;
			will-change: transform;
		}

		.finals-intro {
			flex-shrink: 0;
			width: max-content;
		}

		.final-item {
			height: 68svh;
			transition: box-shadow 0.3s ease;
		}

		.final-item:hover {
			box-shadow: 14px 14px 0 0 var(--p);
		}

		.final-item img {
			width: auto;
			height: 100%;
			max-width: 75vw;
			object-fit: contain;
		}

		.finals-progress {
			position: absolute;
			right: 8vw;
			bottom: 5svh;
			left: 8vw;
			display: block;
			height: 6px;
			background: rgb(11 7 16 / 0.12);
		}

		.finals-progress span {
			display: block;
			height: 100%;
			background: var(--color-ink);
			transform: scaleX(0);
			transform-origin: left;
		}
	}

	/* ---------- FIN ---------- */
	.outro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		padding: 5rem 1rem;
		border-block: 4px solid var(--color-ink);
		background: var(--p);
		color: var(--p-on);
		text-align: center;
	}

	.outro-title {
		font-family: var(--font-heading);
		font-size: clamp(3rem, 10vw, 8rem);
		line-height: 1;
	}

	/* Navigation entre projets */
	.project-nav {
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 28px;
		border: 3px solid var(--color-ink);
		background: #fff;
		box-shadow: var(--shadow-brutal);
		transition:
			translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.project-nav--next {
		align-items: flex-end;
		text-align: right;
	}

	.project-nav:hover {
		translate: -3px -3px;
		background: var(--color-ink);
		color: #fff;
		box-shadow: 9px 9px 0 0 var(--color-iris);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-band-track {
			animation: none;
		}
	}

	/* ---------- VISIONNEUSE ---------- */
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 64px 16px;
		border: 0;
		background: transparent;
		color: #fff;
	}

	.lightbox[open] {
		display: grid;
		place-items: center;
	}

	.lightbox::backdrop {
		background: rgb(11 7 16 / 0.92);
	}

	.lightbox img {
		max-width: min(100%, 1400px);
		max-height: calc(100dvh - 128px);
		object-fit: contain;
		border: 3px solid #fff;
		background: #fff;
	}

	.lightbox-count {
		position: absolute;
		left: 50%;
		bottom: 20px;
		transform: translateX(-50%);
		font-family: var(--font-heading);
	}

	.lightbox-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 3px solid var(--color-ink);
		background: #fff;
		color: var(--color-ink);
		transform: skewX(-12deg);
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.lightbox-btn:hover {
		background: var(--color-lilac);
	}

	.lightbox-btn[hidden] {
		display: none;
	}

	.lightbox-close {
		top: 16px;
		right: 16px;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		margin-top: -26px;
	}

	.lightbox-prev {
		left: 16px;
	}

	.lightbox-next {
		right: 16px;
	}

	@media (max-width: 767px) {
		.lightbox-prev,
		.lightbox-next {
			top: auto;
			bottom: 12px;
			margin-top: 0;
		}

		.lightbox-count {
			bottom: 28px;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	/* ---------- HERO : le nom du projet tient toujours en entier ---------- */
	// Les mots ne se coupent pas : on réduit la taille jusqu'à ce que le titre tienne en largeur
	// et dans la hauteur laissée par le disque du logo.
	const heroTitle = document.querySelector<HTMLElement>(".hero-title")!;
	const heroCenter = document.querySelector<HTMLElement>(".hero-center")!;
	const discWrap = document.querySelector<HTMLElement>(".hero-disc-wrap")!;
	function fitTitle() {
		heroTitle.style.fontSize = "";
		const style = getComputedStyle(heroCenter);
		const maxW = heroCenter.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
		const maxH = heroCenter.clientHeight - discWrap.offsetHeight;
		let size = parseFloat(getComputedStyle(heroTitle).fontSize);
		while (size > 20 && (heroTitle.scrollWidth > maxW || heroTitle.offsetHeight > maxH)) {
			size *= 0.94;
			heroTitle.style.fontSize = `${size}px`;
		}
	}
	fitTitle();
	document.fonts.ready.then(fitTitle);
	let resizeFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(fitTitle);
	});

	const mm = gsap.matchMedia();

	mm.add("(prefers-reduced-motion: no-preference)", () => {
		/* ---------- HERO : entrée ---------- */
		// L'entrée et le défilement animent des propriétés (ou éléments) distinctes pour ne pas se contredire
		const title = document.querySelector<HTMLElement>(".hero-title")!;
		gsap
			.timeline({ delay: 0.1 })
			.from(".hero-disc-wrap", { scale: 0, rotate: -120, duration: 1.1, ease: "back.out(1.6)" })
			.from(".hero-title .char", {
				yPercent: 120,
				duration: 1,
				ease: "power4.out",
				stagger: 0.04,
				// Les lettres sortent ensuite de leur masque pour pouvoir s'envoler au défilement
				onComplete: () => title.classList.add("is-ready"),
			}, 0.25)
			.from(".hero-band", { yPercent: 160, duration: 0.9, ease: "power3.out" }, 0.5)
			.from(".hero-top > *", { y: -20, opacity: 0, duration: 0.7, ease: "power3.out", stagger: 0.1 }, 0.6);

		/* ---------- HERO : au défilement, le disque avale l'écran et les lettres s'envolent ---------- */
		const hero = document.querySelector<HTMLElement>(".hero")!;
		const disc = document.querySelector<HTMLElement>(".hero-disc")!;
		// Échelle nécessaire pour que le disque couvre tout le hero depuis sa position
		const coverScale = () => {
			const h = hero.getBoundingClientRect();
			const d = disc.getBoundingClientRect();
			const cx = d.left + d.width / 2 - h.left;
			const cy = d.top + d.height / 2 - h.top;
			const far = Math.hypot(Math.max(cx, h.width - cx), Math.max(cy, h.height - cy));
			return (far * 2) / disc.offsetWidth + 0.2;
		};

		const heroTl = gsap.timeline({
			scrollTrigger: { trigger: ".hero", start: "top top", end: "+=110%", pin: true, scrub: 0.6, invalidateOnRefresh: true },
		});
		heroTl
			.to(".hero-title .char", {
				y: () => gsap.utils.random(-260, 260),
				x: () => gsap.utils.random(-120, 120),
				rotate: () => gsap.utils.random(-50, 50),
				opacity: 0,
				ease: "power2.in",
				stagger: { each: 0.02, from: "center" },
				duration: 0.5,
			})
			.to([".hero-band", ".hero-top"], { opacity: 0, duration: 0.3 }, 0)
			.to(".hero-logo", { scale: 0.4, opacity: 0, duration: 0.35 }, 0.15)
			.to(disc, { scale: coverScale, borderWidth: 0, boxShadow: "0 0 0 0 rgba(0,0,0,0)", ease: "power2.in", duration: 0.6 }, 0.25);
	});

	/* ---------- CHAPITRES (grand écran) ---------- */
	mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
		// Inspirations : chaque image tombe à sa place dans le moodboard
		const inspi = document.querySelector<HTMLElement>(".inspi");
		if (inspi) {
			const items = gsap.utils.toArray<HTMLElement>(".inspi-item");
			gsap
				.timeline({
					scrollTrigger: { trigger: inspi, start: "top top", end: `+=${60 + items.length * 45}%`, pin: true, scrub: 0.6 },
				})
				.from(".inspi-title", { scale: 0.6, opacity: 0, duration: 0.6 })
				.from(
					items,
					{
						y: () => innerHeight * 1.1,
						x: () => gsap.utils.random(-200, 200),
						rotate: () => gsap.utils.random(-35, 35),
						scale: 1.3,
						ease: "power3.out",
						duration: 1,
						stagger: 0.6,
					},
					0.3,
				)
				.to(".inspi-title", { scale: 1.15, opacity: 0.35, ease: "none", duration: 0.4 + items.length * 0.6 }, 0.6);
		}

		// Réalisation : la piste défile horizontalement pendant le défilement vertical
		const stage = document.querySelector<HTMLElement>(".finals-stage");
		const track = document.querySelector<HTMLElement>(".finals-track");
		if (stage && track) {
			const distance = () => Math.max(0, track.scrollWidth - innerWidth);
			const scroll = gsap.timeline({
				scrollTrigger: {
					trigger: stage,
					start: "top top",
					end: () => `+=${distance()}`,
					pin: true,
					scrub: 0.6,
					invalidateOnRefresh: true,
				},
			});
			scroll
				.to(track, { x: () => -distance(), ease: "none" })
				.to(".finals-progress span", { scaleX: 1, ease: "none" }, 0);

			// Chaque visuel se redresse en entrant dans l'écran
			gsap.utils.toArray<HTMLElement>(".final-item").forEach((item) => {
				gsap.from(item, {
					scale: 0.8,
					rotate: 4,
					ease: "none",
					scrollTrigger: {
						trigger: item,
						containerAnimation: scroll,
						start: "left right",
						end: "center center",
						scrub: true,
					},
				});
			});

			// La largeur de la piste dépend des images : on recalcule une fois chacune chargée
			track.querySelectorAll("img").forEach((img) => {
				if (!img.complete) img.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
			});
		}

		// Le header masquerait le haut des scènes épinglées : il reste caché pendant les chapitres
		const story = document.querySelector<HTMLElement>(".story");
		if (story) {
			const setLock = (locked: boolean, reveal = false) =>
				window.dispatchEvent(new CustomEvent("headerLock", { detail: { locked, reveal } }));
			ScrollTrigger.create({
				trigger: story,
				start: "top top",
				end: "bottom bottom",
				onToggle: (self) => setLock(self.isActive, !self.isActive && self.direction < 0),
			});
			return () => setLock(false, true);
		}
	});

	// Sur mobile, les visuels apparaissent simplement au défilement
	mm.add("(max-width: 1023px) and (prefers-reduced-motion: no-preference)", () => {
		gsap.utils.toArray<HTMLElement>(".inspi-item, .final-item").forEach((item) => {
			gsap.from(item, {
				y: 60,
				opacity: 0,
				rotate: gsap.utils.random(-4, 4),
				duration: 0.8,
				ease: "power3.out",
				scrollTrigger: { trigger: item, start: "top 90%", once: true },
			});
		});
	});

	/* ---------- VISIONNEUSE ---------- */
	const dialog = document.getElementById("lightbox") as HTMLDialogElement;
	const img = document.getElementById("lightbox-img") as HTMLImageElement;
	const count = document.getElementById("lightbox-count")!;
	const prevBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
	const nextBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;

	// Une liste d'images par groupe
	const groups = new Map<string, { src: string; alt: string }[]>();
	document.querySelectorAll<HTMLAnchorElement>("[data-lightbox]").forEach((link) => {
		const group = link.dataset.lightbox!;
		const index = Number(link.dataset.index);
		const list = groups.get(group) ?? [];
		list[index] ??= { src: link.href, alt: link.querySelector("img")?.alt ?? "" };
		groups.set(group, list);
	});

	let current: { src: string; alt: string }[] = [];
	let index = 0;

	function show(i: number) {
		index = (i + current.length) % current.length;
		img.src = current[index].src;
		img.alt = current[index].alt;
		count.textContent = current.length > 1 ? `${index + 1} / ${current.length}` : "";
		prevBtn.hidden = nextBtn.hidden = current.length < 2;
	}

	document.addEventListener("click", (e) => {
		const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-lightbox]");
		if (!link || e.metaKey || e.ctrlKey) return;
		e.preventDefault();
		current = groups.get(link.dataset.lightbox!) ?? [];
		show(Number(link.dataset.index));
		dialog.showModal();
		window.lenis?.stop();
	});

	prevBtn.addEventListener("click", () => show(index - 1));
	nextBtn.addEventListener("click", () => show(index + 1));
	dialog.querySelector("[data-lightbox-close]")!.addEventListener("click", () => dialog.close());
	// Un clic hors de l'image ferme la visionneuse
	dialog.addEventListener("click", (e) => {
		if (e.target === dialog) dialog.close();
	});
	dialog.addEventListener("keydown", (e) => {
		if (e.key === "ArrowLeft") show(index - 1);
		if (e.key === "ArrowRight") show(index + 1);
	});
	dialog.addEventListener("close", () => window.lenis?.start());
</script>
