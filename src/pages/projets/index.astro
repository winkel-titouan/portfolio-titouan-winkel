---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ContactCta from "../../components/ContactCta.astro";
import { pb, getCoverUrl, getFileUrl, type Projet } from "../../utils/pb";

let projets: Projet[] = [];
let errorMessage = "";

try {
	projets = await pb.collection("projets").getFullList<Projet>({
		sort: "-created",
	});
} catch (error: unknown) {
	errorMessage = "Les projets n'ont pas pu être chargés. Réessayez dans quelques instants.";
	console.error("Erreur lors de la récupération des projets:", error);
}

// Visuels de production finale de chaque projet, pour le panneau d'aperçu
const visualsOf = (projet: Projet) => (projet.prod_finale ?? []).map((file) => getFileUrl(projet.id, file));
const first = projets[0];
const firstVisuals = first ? visualsOf(first) : [];
---

<Layout
	title="Mes Projets - Titouan Winkel"
	description="Tous les projets de Titouan Winkel : identités visuelles, supports print, sites web et contenus vidéo."
>
	<main class="overflow-x-clip">
		<!-- HERO -->
		<section class="projects-hero relative">
			<div class="projects-hero-bg absolute inset-0" aria-hidden="true">
				<div class="projects-hero-grid absolute inset-0"></div>
			</div>

			<div class="relative container mx-auto px-4 md:px-6 pt-16 md:pt-24 pb-14 md:pb-20">
				<div class="flex flex-wrap items-end justify-between gap-10">
					<div class="space-y-6 md:space-y-8 max-w-2xl">
						<p class="eyebrow" data-hero-in>
							<span class="dot" aria-hidden="true"></span>
							Portfolio
						</p>
						<h1 class="projects-title text-5xl md:text-7xl xl:text-8xl leading-[1.02]">
							<span class="line"><span>Mes</span></span>
							<span class="line"><span class="title-highlight text-white">projets.</span></span>
						</h1>
						<p class="text-lg md:text-xl leading-relaxed" data-hero-in>
							Identités visuelles, supports print, sites web et vidéo : des projets d'études, de stage
							et personnels, du croquis à la réalisation finale.
						</p>
					</div>

					<p class="project-total" data-hero-in>
						<span class="font-heading text-6xl md:text-8xl leading-none">{String(projets.length).padStart(2, "0")}</span>
						<span class="text-sm md:text-base">projets<br />réalisés</span>
					</p>
				</div>
			</div>
		</section>

		<!-- LISTE -->
		<section class="container mx-auto px-4 md:px-6 pt-10 md:pt-14">
			<div class="flex justify-end mb-10 md:mb-12">
				<div class="sort" role="group" aria-label="Trier par date">
					<button class="sort-btn is-active" data-sort="recent" aria-pressed="true"><span class="unskew">Récents</span></button>
					<button class="sort-btn" data-sort="ancien" aria-pressed="false"><span class="unskew">Anciens</span></button>
				</div>
			</div>

			{errorMessage && <p class="empty-state">{errorMessage}</p>}

			<div class="projects-layout">
				<!-- Aperçu des visuels du projet survolé (grand écran uniquement) -->
				{
					first && (
						<aside class="preview-panel" aria-label="Aperçu du projet">
							<p class="preview-hint">Cliquez sur un projet pour voir ses visuels.</p>
							<div class="preview-wrap">
								<div class="preview-card">
									<span class="corner corner-tl" aria-hidden="true" />
									<span class="corner corner-br" aria-hidden="true" />

									<div class="flex items-center justify-between gap-4 mb-4">
										<span class="preview-label">Aperçu</span>
										<span id="preview-count" class="preview-count">
											{firstVisuals.length > 0 ? `1 / ${firstVisuals.length}` : ""}
										</span>
									</div>

									<a id="preview-stage" href={`/projets/${first.id}`} class="preview-stage" tabindex="-1">
										{firstVisuals.length > 0 ? (
											<img id="preview-img" src={firstVisuals[0]} alt={`${first.nom_projet}, visuel 1`} />
										) : (
											<img id="preview-img" alt="" hidden />
										)}
										<span id="preview-empty" class="preview-empty" hidden={firstVisuals.length > 0}>
											Pas encore de visuel
										</span>
									</a>

									<div id="preview-thumbs" class="preview-thumbs scrollbar-hide" role="group" aria-label="Visuels du projet">
										{firstVisuals.map((src, i) => (
											<button class:list={["preview-thumb", { "is-active": i === 0 }]} data-index={i} aria-label={`Afficher le visuel ${i + 1}`}>
												<img src={src} alt="" loading="lazy" />
											</button>
										))}
									</div>

									<div class="preview-foot">
										<h2 id="preview-title" class="text-2xl leading-tight">{first.nom_projet}</h2>
										<a id="preview-link" href={`/projets/${first.id}`} class="preview-cta">
											Voir le projet
											<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
												<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" />
											</svg>
										</a>
									</div>
								</div>
							</div>
						</aside>
					)
				}

				<ul id="projectsList" class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-14 md:gap-x-12 md:gap-y-16 px-2">
					{
						projets.map((projet, i) => (
							<li
								class:list={["project-item", { "is-previewed": i === 0 }]}
								data-created={projet.created}
								data-id={projet.id}
								data-name={projet.nom_projet}
								data-visuals={JSON.stringify(visualsOf(projet))}
							>
								<ProjectCard href={`/projets/${projet.id}`} project={projet} imageUrl={getCoverUrl(projet)} showCta={false} />
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<ContactCta />
	</main>
</Layout>

<style>
	/* ---------- HERO ---------- */
	.projects-hero {
		margin-top: calc(-1 * var(--header-h));
		padding-top: var(--header-h);
	}

	.projects-hero-bg {
		background: linear-gradient(180deg, #d5b9ff 0%, #e6d5ff 70%, #f4edff 100%);
	}

	.projects-hero-grid {
		background-image:
			linear-gradient(rgb(11 7 16 / 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgb(11 7 16 / 0.07) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 75%);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		background: rgb(255 255 255 / 0.7);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.eyebrow .dot {
		width: 10px;
		height: 10px;
		border-radius: 9999px;
		background: var(--color-grape);
	}

	.projects-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.projects-title .line > span {
		display: inline-block;
	}

	.title-highlight {
		position: relative;
		z-index: 0;
		padding: 0 0.15em;
		margin-left: -0.05em;
	}

	.title-highlight::before {
		content: "";
		position: absolute;
		inset: 0.1em 0 0.02em;
		z-index: -1;
		background: var(--color-ink);
		transform: skewX(-15deg);
	}

	.project-total {
		display: flex;
		align-items: flex-end;
		gap: 12px;
	}

	.project-total .font-heading {
		color: transparent;
		-webkit-text-stroke: 2px var(--color-ink);
	}

	/* ---------- APERÇU ---------- */
	.projects-layout {
		display: grid;
		gap: 4rem;
		align-items: start;
	}

	/* Le survol n'existe pas au doigt : l'aperçu n'apparaît que sur grand écran */
	.preview-panel {
		display: none;
	}

	@media (min-width: 1024px) {
		.projects-layout {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		}

		.preview-panel {
			position: sticky;
			top: 32px;
			display: block;
			transition: top 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}

		:global(body:has(.site-header:not(.is-hidden))) .preview-panel {
			top: calc(var(--header-h) + 32px);
		}
	}

	/* Ombre diffuse identique aux cartes projets, sur un parent isolé */
	.preview-wrap {
		position: relative;
		isolation: isolate;
	}

	.preview-wrap::before {
		content: "";
		position: absolute;
		inset: 10% 4% -2% 16%;
		z-index: -1;
		background: linear-gradient(135deg, rgb(11 7 16 / 0.15) 0%, rgb(11 7 16 / 0.55) 60%, var(--color-ink) 100%);
		filter: blur(26px);
		opacity: 0.35;
		transform: translate(14px, 10px);
	}

	.preview-card {
		position: relative;
		padding: 20px;
		border: 3px solid var(--color-ink);
		background: #fff;
	}

	.corner {
		position: absolute;
		z-index: 2;
		width: 24px;
		height: 24px;
		border: 8px solid var(--color-ink);
	}

	.corner-tl {
		top: -3px;
		left: -3px;
		border-right: 0;
		border-bottom: 0;
	}

	.corner-br {
		bottom: -3px;
		right: -3px;
		border-left: 0;
		border-top: 0;
	}

	.preview-label {
		padding: 2px 12px;
		background: var(--color-ink);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		transform: skewX(-12deg);
	}

	.preview-count {
		font-family: var(--font-heading);
		font-size: 0.9rem;
	}

	/* Le panneau entier (consigne, miniatures, bouton) doit tenir dans l'écran sans défiler :
	   on retire de la hauteur visible le header, les marges et ~300px d'éléments fixes */
	.preview-stage {
		position: relative;
		display: grid;
		place-items: center;
		height: clamp(180px, calc(100svh - var(--header-h) - 64px - 300px), 480px);
		overflow: hidden;
		border: 3px solid var(--color-ink);
		background:
			radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.45) 70%),
			var(--color-lilac-soft);
	}

	.preview-stage img {
		max-width: 100%;
		max-height: 100%;
		padding: 14px;
		object-fit: contain;
	}

	.preview-empty {
		font-family: var(--font-heading);
		opacity: 0.6;
	}

	.preview-thumbs {
		display: flex;
		gap: 10px;
		margin-top: 14px;
		padding: 3px 3px 6px;
		overflow-x: auto;
	}

	.preview-thumbs:empty {
		display: none;
	}

	/* Les miniatures sont recréées en JS (sans l'attribut de scope Astro) : styles globaux sous .preview-thumbs */
	.preview-thumbs :global(.preview-thumb) {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border: 3px solid var(--color-ink);
		background: var(--color-lilac-soft);
		opacity: 0.55;
		cursor: pointer;
		transition:
			opacity 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.preview-thumbs :global(.preview-thumb img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.preview-thumbs :global(.preview-thumb:hover) {
		opacity: 1;
	}

	.preview-thumbs :global(.preview-thumb.is-active) {
		opacity: 1;
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 0 var(--color-iris);
	}

	.preview-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 18px;
		padding-top: 16px;
		border-top: 3px solid var(--color-ink);
	}

	.preview-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.preview-cta:hover {
		background: var(--color-ink);
		color: #fff;
	}

	.preview-hint {
		margin-bottom: 20px;
		font-size: 0.9rem;
		opacity: 0.6;
	}

	/* Repère sur la carte affichée dans l'aperçu */
	@media (min-width: 1024px) {
		.project-item {
			position: relative;
		}

		.project-item::after {
			content: "En aperçu";
			position: absolute;
			top: -14px;
			right: 18px;
			z-index: 3;
			padding: 2px 10px;
			background: var(--color-lilac);
			border: 2px solid var(--color-ink);
			font-family: var(--font-heading);
			font-size: 0.75rem;
			opacity: 0;
			transform: translateY(6px) skewX(-12deg);
			transition:
				opacity 0.25s ease,
				transform 0.25s ease;
			pointer-events: none;
		}

		.project-item.is-previewed::after {
			opacity: 1;
			transform: translateY(0) skewX(-12deg);
		}
	}

	/* ---------- TRI ---------- */
	/* Le texte est redressé à l'intérieur du bouton incliné */
	.unskew {
		display: inline-flex;
		transform: skewX(12deg);
	}

	.sort {
		display: inline-flex;
		border: 3px solid var(--color-ink);
		transform: skewX(-12deg);
	}

	.sort-btn {
		padding: 8px 16px;
		background: #fff;
		font-size: 0.95rem;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.sort-btn + .sort-btn {
		border-left: 3px solid var(--color-ink);
	}

	.sort-btn.is-active {
		background: var(--color-lilac);
	}

	.sort-btn:not(.is-active):hover {
		background: var(--color-lilac-soft);
	}

	/* ---------- LISTE ---------- */
	.empty-state {
		padding: 3rem 1rem;
		border: 3px dashed var(--color-ink);
		text-align: center;
		font-size: 1.125rem;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { Flip } from "gsap/Flip";

	gsap.registerPlugin(Flip);

	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const list = document.getElementById("projectsList")!;
	const items = Array.from(list.querySelectorAll<HTMLElement>(".project-item"));
	const sortBtns = document.querySelectorAll<HTMLButtonElement>("[data-sort]");
	let sort = "recent";

	function setPressed(active: HTMLButtonElement) {
		sortBtns.forEach((b) => {
			b.classList.toggle("is-active", b === active);
			b.setAttribute("aria-pressed", String(b === active));
		});
	}

	function render() {
		const state = Flip.getState(items);

		const sorted = [...items].sort((a, b) => {
			const diff = new Date(a.dataset.created ?? "").getTime() - new Date(b.dataset.created ?? "").getTime();
			return sort === "recent" ? -diff : diff;
		});
		sorted.forEach((item) => list.appendChild(item));

		Flip.from(state, {
			duration: reducedMotion ? 0 : 0.6,
			ease: "power3.inOut",
			absolute: true,
			stagger: 0.03,
		});
	}

	/* ---------- APERÇU ---------- */
	const panel = document.querySelector<HTMLElement>(".preview-panel");
	if (panel) {
		const stage = document.getElementById("preview-stage") as HTMLAnchorElement;
		const img = document.getElementById("preview-img") as HTMLImageElement;
		const empty = document.getElementById("preview-empty")!;
		const count = document.getElementById("preview-count")!;
		const thumbs = document.getElementById("preview-thumbs")!;
		const title = document.getElementById("preview-title")!;
		const link = document.getElementById("preview-link") as HTMLAnchorElement;

		let current = items.find((item) => item.classList.contains("is-previewed")) ?? items[0];
		let visuals: string[] = JSON.parse(current?.dataset.visuals ?? "[]");
		let index = 0;

		function showVisual(i: number) {
			index = i;
			const src = visuals[i];
			img.hidden = !src;
			empty.hidden = !!src;
			count.textContent = visuals.length ? `${i + 1} / ${visuals.length}` : "";
			thumbs.querySelectorAll(".preview-thumb").forEach((t, j) => t.classList.toggle("is-active", j === i));
			if (!src) return;
			img.alt = `${current.dataset.name}, visuel ${i + 1}`;
			// Fondu enchaîné entre deux images
			gsap.killTweensOf(img);
			gsap.to(img, {
				opacity: 0,
				duration: reducedMotion ? 0 : 0.15,
				onComplete: () => {
					img.src = src;
					gsap.to(img, { opacity: 1, duration: reducedMotion ? 0 : 0.3 });
				},
			});
		}

		function preview(item: HTMLElement) {
			if (item === current) return;
			current.classList.remove("is-previewed");
			item.classList.add("is-previewed");
			current = item;
			visuals = JSON.parse(item.dataset.visuals ?? "[]");

			title.textContent = item.dataset.name ?? "";
			link.href = stage.href = `/projets/${item.dataset.id}`;
			thumbs.replaceChildren(
				...visuals.map((src, i) => {
					const btn = document.createElement("button");
					btn.className = "preview-thumb";
					btn.dataset.index = String(i);
					btn.setAttribute("aria-label", `Afficher le visuel ${i + 1}`);
					const thumb = document.createElement("img");
					thumb.src = src;
					thumb.alt = "";
					thumb.loading = "lazy";
					btn.append(thumb);
					return btn;
				}),
			);
			showVisual(0);
		}

		// Grand écran : un clic sur une carte l'affiche dans l'aperçu au lieu d'ouvrir le projet
		// (le bouton « Voir le projet » de l'aperçu mène ensuite à la page). Ailleurs, le lien reste normal.
		const wide = matchMedia("(min-width: 1024px)");
		items.forEach((item) => {
			item.querySelector("a")?.addEventListener("click", (e) => {
				if (!wide.matches || e.metaKey || e.ctrlKey || e.shiftKey) return;
				e.preventDefault();
				preview(item);
			});
		});

		thumbs.addEventListener("click", (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".preview-thumb");
			if (btn) showVisual(Number(btn.dataset.index));
		});
		// Flèches du clavier pour parcourir les visuels depuis les miniatures
		thumbs.addEventListener("keydown", (e) => {
			if (!visuals.length || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
			e.preventDefault();
			const next = (index + (e.key === "ArrowRight" ? 1 : -1) + visuals.length) % visuals.length;
			showVisual(next);
			thumbs.querySelectorAll<HTMLButtonElement>(".preview-thumb")[next]?.focus();
		});
	}

	sortBtns.forEach((btn) =>
		btn.addEventListener("click", () => {
			sort = btn.dataset.sort!;
			setPressed(btn);
			render();
		}),
	);

	if (!reducedMotion) {
		gsap.from(".projects-title .line > span", { yPercent: 110, duration: 1.1, ease: "power4.out", stagger: 0.12, delay: 0.15 });
		gsap.from("[data-hero-in]", { y: 30, opacity: 0, duration: 0.8, ease: "power3.out", stagger: 0.1, delay: 0.3 });
		gsap.from(items, {
			y: 60,
			opacity: 0,
			duration: 0.9,
			ease: "power3.out",
			stagger: 0.08,
			delay: 0.4,
			clearProps: "transform,opacity",
		});
	}
</script>
