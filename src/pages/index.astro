---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Skills from "../components/Skills.astro";
import SkewButton from "../components/SkewButton.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCta from "../components/ContactCta.astro";
import laptopUrl from "../assets/3d/laptop.glb?url";
import { supabase, getCoverUrl, withStorageFiles, type Projet } from "../utils/supabase";

let projets: Projet[] = [];
try {
	const { data, error } = await supabase.from("projets").select("*").eq("a_la_une", true).order("created_at");
	if (error) throw error;
	projets = await Promise.all(data.map(withStorageFiles));
} catch (error) {
	console.error("Erreur lors de la récupération des projets:", error);
}

const marqueeItems = [
	"Identité visuelle",
	"Design graphique",
	"Web design",
	"Illustration",
	"Communication",
	"Motion & vidéo",
];

const steps = [
	{
		title: "Comprendre",
		text: "J'écoute, je questionne, j'analyse : le public, le message, les contraintes. Un bon design commence par un bon brief.",
		tags: ["Brief", "Recherche", "Benchmark"],
	},
	{
		title: "Imaginer",
		text: "Moodboards, croquis, pistes graphiques. J'explore plusieurs directions avant d'en retenir une.",
		tags: ["Moodboard", "Croquis", "Concepts"],
	},
	{
		title: "Concevoir",
		text: "Identité, maquettes, intégration : la piste choisie prend forme sur Figma, Illustrator ou directement en code.",
		tags: ["Figma", "Illustrator", "Astro"],
	},
	{
		title: "Livrer",
		text: "Fichiers propres, site en ligne, supports imprimés : le projet est prêt à vivre, et à être raconté.",
		tags: ["Export", "Mise en ligne", "Suivi"],
	},
];
---

<Layout title="Titouan Winkel - Designer web">
	<link slot="head" rel="preload" href={laptopUrl} as="fetch" type="model/gltf-binary" crossorigin />

	<main class="overflow-x-clip">
		<!-- HERO : la scène reste collée pendant que le scroll pilote le PC 3D -->
		<section id="hero" class="hero relative" aria-label="Introduction">
			<div class="hero-stage sticky top-0 h-svh overflow-hidden">
				<div class="hero-bg absolute inset-0" aria-hidden="true">
					<div class="hero-grid absolute inset-0"></div>
					<div class="blob blob-1"></div>
					<div class="blob blob-2"></div>
				</div>

				<canvas id="laptop-canvas" class="absolute inset-0 h-full w-full opacity-0" aria-hidden="true"></canvas>

				<div id="laptop-loader" class="laptop-loader" aria-hidden="true">
					<span></span><span></span>
				</div>


				<div class="relative z-10 container mx-auto h-full px-4 md:px-6 flex items-start pt-[calc(var(--header-h)+6vh)] lg:items-center lg:pt-(--header-h)">
					<div class="hero-copy max-w-xl xl:max-w-2xl space-y-6 md:space-y-8">
						<p class="hero-eyebrow">
							<span class="dot" aria-hidden="true"></span>
							Titouan Winkel — Graphiste &amp; designer web
						</p>

						<h1 class="hero-title text-4xl md:text-6xl xl:text-7xl leading-[1.08]">
							<span class="line"><span>Chaque projet</span></span>
							<span class="line"><span>est une nouvelle</span></span>
							<span class="line"><span class="text-white title-highlight">aventure.</span></span>
						</h1>

						<div class="hero-actions flex flex-col sm:flex-row gap-5 sm:gap-8">
							<SkewButton href="/projets" icon="arrow" variant="primary">Découvrir mes projets</SkewButton>
							<SkewButton href="/CV_Titouan_Winkel.pdf" download icon="download">Télécharger mon CV</SkewButton>
						</div>
					</div>
				</div>

				<div class="scroll-hint" aria-hidden="true">
					<span class="mouse"><span></span></span>
					<span>Scroll</span>
				</div>

				<div class="hero-progress" aria-hidden="true"><span></span></div>
			</div>
		</section>

		<!-- BANDEAU DÉFILANT -->
		<section class="marquees relative py-14 md:py-20" aria-hidden="true">
			{
				[
					{ cls: "marquee-back", dir: 1 },
					{ cls: "marquee-front", dir: -1 },
				].map(({ cls, dir }) => (
					<div class:list={["marquee", cls]}>
						<div class="marquee-track" data-dir={dir}>
							{[0, 1].map(() => (
								<div class="marquee-group">
									{marqueeItems.map((item) => (
										<span class="marquee-item">
											{item}
											<span class="marquee-star">✦</span>
										</span>
									))}
								</div>
							))}
						</div>
					</div>
				))
			}
		</section>

		<!-- MA MÉTHODE : défilement horizontal piloté par le scroll -->
		<section id="methode" class="method">
			<div class="method-stage">
				<div class="method-inner">
					<div class="method-track">
						<div class="method-intro">
							<SectionTitle text="Ma méthode" />
							<p class="method-lead text-3xl md:text-4xl leading-tight">
								De l'idée au projet,<br />en <span class="method-hl">quatre étapes.</span>
							</p>
						</div>
						<ol class="method-steps">
							{steps.map((step) => (
								<li class="step">
									<h3 class="step-title text-3xl md:text-4xl">{step.title}</h3>
									<p class="step-text md:text-lg leading-relaxed">{step.text}</p>
									<ul class="step-tags">
										{step.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</li>
							))}
						</ol>
					</div>

					<div class="method-progress" aria-hidden="true"><span></span></div>
				</div>
			</div>
		</section>

		<!-- MES PROJETS : le scroll ouvre le booster et distribue les cartes -->
		<section id="projets" class="projects">
			<div class="projects-stage container mx-auto px-4 md:px-6">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<SectionTitle text="Mes projets" />
					{
						projets.length > 1 && (
							<div class="carousel-nav flex gap-3 mb-8">
								<button class="carousel-btn" data-carousel-prev aria-label="Projet précédent">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="square" /></svg>
								</button>
								<button class="carousel-btn" data-carousel-next aria-label="Projet suivant">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" /></svg>
								</button>
							</div>
						)
					}
				</div>

				{
					projets.length > 0 ? (
						<div class="carousel-stage relative">
							<div class="carousel scrollbar-hide" tabindex="0" aria-label="Carrousel des projets">
								<ul class="carousel-track">
									{projets.map((projet) => (
										<li class="carousel-item">
											<ProjectCard
												href={`/projets/${projet.id}`}
												project={projet}
												imageUrl={getCoverUrl(projet)}
											/>
										</li>
									))}
								</ul>
							</div>

							<!-- Booster d'où sortent les cartes au fil du scroll -->
							<div class="booster" aria-hidden="true">
								<span class="booster-flash"></span>
								<div class="booster-top"><span class="booster-crimp"></span></div>
								<div class="booster-body">
									<img src="/logo_perso.svg" alt="" class="booster-logo" draggable="false" />
									<span class="booster-title">Mes projets</span>
									<span class="booster-count">{projets.length} cartes</span>
								</div>
								<span class="booster-crimp booster-crimp-bottom"></span>
							</div>
						</div>
					) : (
						<p class="mt-10 text-center text-lg opacity-70">Les projets arrivent très bientôt.</p>
					)
				}

				<div class="projects-footer mt-6 flex flex-col-reverse md:flex-row items-center gap-8 md:gap-12">
					<SkewButton href="/projets" icon="arrow">Voir tous les projets</SkewButton>
					{projets.length > 1 && (
						<div class="carousel-progress w-full md:flex-1" aria-hidden="true"><span></span></div>
					)}
				</div>
			</div>
		</section>

		<!-- MES COMPÉTENCES -->
		<section id="competences" class="container mx-auto px-4 md:px-6 py-16 md:py-24">
			<SectionTitle text="Mes compétences" />
			<Skills />
		</section>

		<ContactCta />
	</main>
</Layout>

<style>
	/* ---------- HERO ---------- */
	.hero {
		height: 280vh;
		margin-top: calc(-1 * var(--header-h));
	}

	.hero-bg {
		background: linear-gradient(180deg, #d5b9ff 0%, #e6d5ff 65%, #fff 100%);
	}

	.hero-grid {
		background-image:
			linear-gradient(rgb(11 7 16 / 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgb(11 7 16 / 0.07) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(ellipse at 65% 45%, #000 20%, transparent 75%);
	}

	.blob {
		position: absolute;
		border-radius: 9999px;
		filter: blur(70px);
		opacity: 0.6;
		animation: drift 14s ease-in-out infinite alternate;
	}

	.blob-1 {
		width: 42vw;
		height: 42vw;
		right: 5%;
		top: 10%;
		background: #a983e2;
	}

	.blob-2 {
		width: 30vw;
		height: 30vw;
		left: -5%;
		bottom: 5%;
		background: #fff;
		animation-delay: -6s;
	}

	@keyframes drift {
		to {
			transform: translate(-4vw, 5vh) scale(1.1);
		}
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		background: rgb(255 255 255 / 0.7);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.hero-eyebrow .dot {
		width: 10px;
		height: 10px;
		border-radius: 9999px;
		background: var(--color-grape);
		box-shadow: 0 0 0 0 rgb(124 58 237 / 0.6);
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		70% {
			box-shadow: 0 0 0 10px rgb(124 58 237 / 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgb(124 58 237 / 0);
		}
	}

	.hero-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.hero-title .line > span {
		display: inline-block;
	}

	/* Surlignage incliné façon bouton du site */
	.title-highlight {
		position: relative;
		padding: 0 0.15em;
		margin-left: -0.05em;
	}

	.title-highlight::before {
		content: "";
		position: absolute;
		inset: 0.1em 0 0.02em;
		z-index: -1;
		background: var(--color-ink);
		transform: skewX(-15deg);
	}

	.laptop-loader {
		position: absolute;
		right: 24%;
		top: 50%;
		width: 48px;
		height: 48px;
		animation: spin 1.2s cubic-bezier(0.7, 0, 0.3, 1) infinite;
		transition: opacity 0.4s ease;
	}

	.laptop-loader span {
		position: absolute;
		width: 20px;
		height: 20px;
		border: 5px solid var(--color-ink);
	}

	.laptop-loader span:first-child {
		top: 0;
		left: 0;
		border-right: 0;
		border-bottom: 0;
	}

	.laptop-loader span:last-child {
		bottom: 0;
		right: 0;
		border-left: 0;
		border-top: 0;
	}

	@media (max-width: 1023px) {
		.laptop-loader {
			right: calc(50% - 24px);
			top: 70%;
		}
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.scroll-hint {
		position: absolute;
		left: 50%;
		bottom: 22px;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		font-family: var(--font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.mouse {
		position: relative;
		width: 24px;
		height: 38px;
		border: 3px solid var(--color-ink);
		border-radius: 14px;
	}

	.mouse span {
		position: absolute;
		left: 50%;
		top: 6px;
		width: 4px;
		height: 8px;
		margin-left: -2px;
		border-radius: 2px;
		background: var(--color-ink);
		animation: wheel 1.6s ease-in-out infinite;
	}

	@keyframes wheel {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		100% {
			transform: translateY(12px);
			opacity: 0;
		}
	}

	.hero-progress {
		position: absolute;
		right: 20px;
		top: 50%;
		width: 4px;
		height: 120px;
		transform: translateY(-50%);
		background: rgb(11 7 16 / 0.15);
	}

	.hero-progress span {
		display: block;
		height: 100%;
		background: var(--color-ink);
		transform: scaleY(0);
		transform-origin: top;
	}

	/* Sans animation : hero classique, PC ouvert et immobile */
	@media (prefers-reduced-motion: reduce) {
		.hero {
			height: auto;
		}

		.scroll-hint,
		.hero-progress {
			display: none;
		}
	}

	/* ---------- BANDEAU ---------- */
	.marquee {
		overflow: hidden;
		border-block: 4px solid var(--color-ink);
		white-space: nowrap;
	}

	.marquee-back {
		background: var(--color-lilac);
		transform: rotate(2deg) scale(1.05);
	}

	.marquee-front {
		margin-top: -3.2rem;
		background: var(--color-ink);
		color: #fff;
		transform: rotate(-2deg) scale(1.05);
	}

	.marquee-track {
		display: flex;
		width: max-content;
	}

	.marquee-group {
		display: flex;
		flex-shrink: 0;
	}

	.marquee-item {
		display: inline-flex;
		align-items: center;
		gap: 2rem;
		padding: 0.9rem 1rem 0.9rem 2rem;
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 3vw, 2.25rem);
		text-transform: uppercase;
	}

	.marquee-star {
		color: var(--color-iris);
	}

	.marquee-back .marquee-star {
		color: var(--color-ink);
	}

	/* ---------- MA MÉTHODE ---------- */
	.method-inner {
		padding: 5rem 0 4rem;
		overflow: hidden;
		background: var(--color-ink);
		color: #fff;
	}

	/* Le crochet du titre est noir : on l'inverse sur fond sombre */
	.method :global([data-bracket]) {
		filter: invert(1);
	}

	.method-lead {
		font-family: var(--font-heading);
	}

	.method-hl {
		position: relative;
		display: inline-block;
		padding: 0 0.15em;
		color: var(--color-ink);
		isolation: isolate;
	}

	.method-hl::before {
		content: "";
		position: absolute;
		inset: 0.08em 0 0.02em;
		z-index: -1;
		background: var(--color-lilac);
		transform: skewX(-15deg);
	}

	.method-track {
		display: grid;
		gap: 2.5rem;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.method-steps {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 768px) {
		.method-track {
			padding: 0 1.5rem;
		}

		.method-steps {
			grid-template-columns: repeat(2, 1fr);
		}

		/* Avec animations : la frise défile horizontalement, scène collée à l'écran */
		:global(.js-motion) .method {
			height: 400vh;
		}

		:global(.js-motion) .method-stage {
			position: sticky;
			top: 0;
			height: 100svh;
		}

		:global(.js-motion) .method-inner {
			display: flex;
			flex-direction: column;
			justify-content: center;
			height: 100%;
			padding: var(--header-h) 0 3rem;
		}

		:global(.js-motion) .method-track {
			display: flex;
			align-items: center;
			gap: 4rem;
			width: max-content;
			max-width: none;
			margin: 0;
			padding-inline: max(1.5rem, calc(50vw - 616px)) 12vw;
		}

		:global(.js-motion) .method-intro {
			width: max(360px, 34vw);
		}

		:global(.js-motion) .method-steps {
			display: flex;
			gap: 2rem;
		}

		:global(.js-motion) .step {
			width: 380px;
			min-height: min(400px, 56svh);
		}
	}

	.step {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		border: 3px solid #fff;
		background: rgb(255 255 255 / 0.04);
		box-shadow: 8px 8px 0 var(--color-iris);
	}

	.step-title {
		color: var(--color-lilac);
	}

	.step-text {
		color: rgb(255 255 255 / 0.8);
	}

	.step-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: auto;
		padding-top: 1rem;
	}

	.step-tags li {
		padding: 2px 10px;
		border: 2px solid var(--color-lilac);
		font-size: 0.85rem;
		font-weight: 600;
		transform: skewX(-12deg);
	}

	.method-progress {
		display: none;
	}

	@media (min-width: 768px) {
		:global(.js-motion) .method-progress {
			display: block;
			width: min(1232px, calc(100% - 3rem));
			height: 4px;
			margin: 3rem auto 0;
			background: rgb(255 255 255 / 0.15);
		}
	}

	.method-progress span {
		display: block;
		height: 100%;
		background: var(--color-lilac);
		transform: scaleX(0);
		transform-origin: left;
	}

	/* ---------- MES PROJETS ---------- */
	.projects-stage {
		padding-block: 4rem 5rem;
	}

	/* Avec animations : la scène reste collée le temps que le scroll ouvre le booster */
	:global(.js-motion) .projects {
		height: 340vh;
	}

	:global(.js-motion) .projects-stage {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100svh;
		padding-block: var(--header-h) 1.5rem;
	}

	/* ---------- CARROUSEL ---------- */
	/* Déborde jusqu'au bord droit de l'écran */
	.carousel {
		margin-left: -1rem;
		margin-right: calc(50% - 50vw);
		margin-bottom: -2.5rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 1.5rem;
		cursor: grab;
		outline-offset: -3px;
	}

	@media (min-width: 768px) {
		.carousel {
			margin-left: -1.5rem;
		}
	}

	.carousel.is-dragging {
		cursor: grabbing;
		scroll-snap-type: none;
	}

	.carousel.is-dragging a {
		pointer-events: none;
	}

	.carousel-track {
		display: flex;
		gap: 2.5rem;
		width: max-content;
		/* Marge basse généreuse : l'ombre floutée des cartes ne doit pas être coupée par le scroll */
		padding: 2rem 1.5rem 5rem;
	}

	.carousel-item {
		position: relative;
		width: min(78vw, 320px);
		scroll-snap-align: start;
	}

	/* Pendant l'ouverture, les cartes doivent pouvoir sortir du cadre du carrousel */
	.carousel-stage.is-opening .carousel {
		overflow: visible;
		pointer-events: none;
	}

	/* Reflet holographique quand une carte atterrit */
	.carousel-item.is-foil::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background: linear-gradient(
			115deg,
			transparent 35%,
			rgb(255 255 255 / 0.85) 46%,
			rgb(213 185 255 / 0.7) 50%,
			rgb(169 131 226 / 0.5) 54%,
			transparent 65%
		);
		background-size: 300% 100%;
		mix-blend-mode: soft-light;
		animation: foil 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	@keyframes foil {
		from {
			background-position: 100% 0;
		}
		to {
			background-position: 0 0;
			opacity: 0;
		}
	}

	/* ---------- BOOSTER ---------- */
	.booster {
		display: none;
		position: absolute;
		left: 50%;
		top: 45%;
		z-index: 10;
		width: 220px;
		height: 330px;
		pointer-events: none;
		filter: drop-shadow(10px 10px 0 var(--color-ink));
	}

	.carousel-stage.has-booster .booster {
		display: block;
	}

	.booster-top,
	.booster-body,
	.booster-crimp-bottom {
		position: absolute;
		left: 0;
		right: 0;
		border: 3px solid var(--color-ink);
	}

	.booster-top {
		top: 0;
		height: 46px;
		border-bottom-style: dashed;
		background: linear-gradient(90deg, var(--color-iris), var(--color-lilac), var(--color-iris));
	}

	.booster-body {
		top: 43px;
		bottom: 22px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		padding: 20px 16px;
		overflow: hidden;
		background:
			linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.7) 45%, transparent 60%) 0 0 / 300% 100%,
			linear-gradient(160deg, var(--color-lilac-soft) 0%, #fff 25%, var(--color-iris) 55%, var(--color-lilac) 75%, var(--color-grape) 100%);
		border-top: 0;
		animation: booster-shine 2.4s linear infinite;
	}

	@keyframes booster-shine {
		from {
			background-position: 100% 0, 0 0;
		}
		to {
			background-position: -200% 0, 0 0;
		}
	}

	/* Bords sertis du sachet */
	.booster-crimp {
		position: absolute;
		inset: 6px 0 auto;
		height: 18px;
		background: repeating-linear-gradient(90deg, rgb(11 7 16 / 0.35) 0 2px, transparent 2px 7px);
	}

	.booster-crimp-bottom {
		inset: auto 0 0;
		height: 25px;
		background:
			repeating-linear-gradient(90deg, rgb(11 7 16 / 0.35) 0 2px, transparent 2px 7px) center / 100% 14px no-repeat,
			linear-gradient(90deg, var(--color-iris), var(--color-lilac), var(--color-iris));
	}

	.booster-logo {
		width: 80%;
	}

	.booster-title {
		font-family: var(--font-heading);
		font-size: 1.6rem;
		line-height: 1.05;
		text-align: center;
		text-transform: uppercase;
	}

	.booster-count {
		padding: 4px 12px;
		background: var(--color-ink);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.booster-flash {
		position: absolute;
		left: 50%;
		top: 46px;
		width: 260px;
		height: 260px;
		margin: -130px 0 0 -130px;
		border-radius: 9999px;
		background: radial-gradient(circle, #fff 0%, rgb(213 185 255 / 0.8) 35%, transparent 70%);
		opacity: 0;
	}

	.carousel-btn {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 3px solid var(--color-ink);
		background: #fff;
		transform: skewX(-12deg);
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			box-shadow 0.25s ease,
			opacity 0.25s ease;
	}

	.carousel-btn:hover:not(:disabled) {
		background: var(--color-ink);
		color: #fff;
		box-shadow: 4px 4px 0 var(--color-iris);
	}

	.carousel-btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.carousel-progress {
		height: 6px;
		background: rgb(11 7 16 / 0.1);
	}

	.carousel-progress span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, var(--color-iris), var(--color-ink));
		transform-origin: left;
		transform: scaleX(0);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import laptopUrl from "../assets/3d/laptop.glb?url";
	import type { LaptopState } from "../scripts/laptop-scene";

	gsap.registerPlugin(ScrollTrigger);

	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

	/* ---------- HERO 3D ---------- */
	const hero = document.getElementById("hero")!;
	const stage = hero.querySelector<HTMLElement>(".hero-stage")!;
	const canvas = document.getElementById("laptop-canvas") as HTMLCanvasElement;
	const loader = document.getElementById("laptop-loader")!;

	const state: LaptopState = reducedMotion
		? { open: 1, rotY: -0.45, rotX: 0.05, offset: 1, screen: 1, zoom: 0, spin: 0 }
		: { open: 0, rotY: -0.6, rotX: 0.12, offset: 1, screen: 0, zoom: 0, spin: 1 };

	import("../scripts/laptop-scene")
		.then(({ createLaptopScene }) => createLaptopScene(canvas, laptopUrl, state))
		.then((scene) => {
			// On ne dessine que lorsque le hero est à l'écran
			new IntersectionObserver(([entry]) => (entry.isIntersecting ? scene.start() : scene.stop())).observe(stage);
			loader.style.opacity = "0";
			setTimeout(() => loader.remove(), 400);
			gsap.to(canvas, { opacity: 1, duration: 1.2, ease: "power2.out" });
			gsap.to(state, { spin: 0, duration: 2, ease: "expo.out" });
		})
		.catch((err) => {
			console.error("Scène 3D indisponible :", err);
			loader.remove();
		});

	if (!reducedMotion) {
		// Intro du texte
		gsap.from(".hero-eyebrow", { y: 20, opacity: 0, duration: 0.8, ease: "power3.out", delay: 0.1 });
		gsap.from(".hero-title .line > span", {
			yPercent: 110,
			duration: 1.1,
			ease: "power4.out",
			stagger: 0.12,
			delay: 0.2,
		});
		gsap.from(".hero-actions > *", { y: 30, opacity: 0, duration: 0.8, stagger: 0.12, delay: 0.7, ease: "power3.out" });
		gsap.from(".scroll-hint", { opacity: 0, duration: 1, delay: 1.4 });

		// Scroll : le texte s'efface, le PC pivote, s'ouvre, s'allume puis la caméra plonge dans l'écran
		gsap.timeline({
			defaults: { ease: "none" },
			scrollTrigger: { trigger: hero, start: "top top", end: "bottom bottom", scrub: 1 },
		})
			.to(".hero-copy", { y: -120, opacity: 0, duration: 0.2, ease: "power2.in" }, 0)
			.to(".scroll-hint", { opacity: 0, duration: 0.06 }, 0)
			.to(state, { offset: 0, duration: 0.42, ease: "power2.inOut" }, 0.04)
			.to(state, { rotY: 0, rotX: 0, duration: 0.45, ease: "power2.inOut" }, 0.04)
			.to(state, { open: 1, duration: 0.4, ease: "power1.inOut" }, 0.12)
			.to(state, { screen: 1, duration: 0.14 }, 0.4)
			.to(state, { zoom: 1, duration: 0.36, ease: "power2.inOut" }, 0.56)
			.to(".hero-progress span", { scaleY: 1, duration: 1 }, 0);
	}

	/* ---------- BANDEAU : vitesse et sens liés au scroll ---------- */
	if (!reducedMotion) {
		const loops = gsap.utils.toArray<HTMLElement>(".marquee-track").map((track) => {
			const dir = Number(track.dataset.dir);
			return gsap.fromTo(
				track,
				{ xPercent: dir > 0 ? -50 : 0 },
				{ xPercent: dir > 0 ? 0 : -50, duration: 28, ease: "none", repeat: -1 },
			);
		});
		ScrollTrigger.create({
			trigger: ".marquees",
			start: "top bottom",
			end: "bottom top",
			onUpdate(self) {
				const boost = 1 + Math.min(Math.abs(self.getVelocity()) / 300, 4);
				loops.forEach((loop) => {
					loop.timeScale(boost);
					gsap.to(loop, { timeScale: 1, duration: 1, ease: "power2.out", overwrite: true });
				});
			},
		});
	}

	/* ---------- CARROUSEL DES PROJETS ---------- */
	const carousel = document.querySelector<HTMLElement>(".carousel");
	if (carousel) {
		const items = carousel.querySelectorAll<HTMLElement>(".carousel-item");
		const prev = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
		const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");
		const bar = document.querySelector<HTMLElement>(".carousel-progress span");

		const step = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : carousel.clientWidth);
		prev?.addEventListener("click", () => carousel.scrollBy({ left: -step(), behavior: "smooth" }));
		next?.addEventListener("click", () => carousel.scrollBy({ left: step(), behavior: "smooth" }));

		function updateCarousel() {
			const max = carousel!.scrollWidth - carousel!.clientWidth;
			const ratio = max > 0 ? carousel!.scrollLeft / max : 1;
			if (bar) bar.style.transform = `scaleX(${Math.max(ratio, 0.04)})`;
			if (prev) prev.disabled = carousel!.scrollLeft < 4;
			if (next) next.disabled = carousel!.scrollLeft > max - 4;
		}
		carousel.addEventListener("scroll", updateCarousel, { passive: true });
		window.addEventListener("resize", updateCarousel);
		updateCarousel();

		// Glisser-déposer à la souris (le tactile utilise le défilement natif)
		let startX = 0;
		let startScroll = 0;
		let pointerId: number | null = null;
		carousel.addEventListener("pointerdown", (e) => {
			if (e.pointerType !== "mouse" || e.button !== 0) return;
			pointerId = e.pointerId;
			startX = e.clientX;
			startScroll = carousel.scrollLeft;
		});
		carousel.addEventListener("pointermove", (e) => {
			if (e.pointerId !== pointerId) return;
			const dx = e.clientX - startX;
			if (!carousel.classList.contains("is-dragging") && Math.abs(dx) > 6) {
				carousel.classList.add("is-dragging");
				carousel.setPointerCapture(e.pointerId);
			}
			if (carousel.classList.contains("is-dragging")) carousel.scrollLeft = startScroll - dx;
		});
		const endDrag = () => {
			if (pointerId === null) return;
			pointerId = null;
			if (!carousel.classList.contains("is-dragging")) return;
			// Laisse le scroll-snap reprendre la main en douceur
			const target = carousel.scrollLeft;
			carousel.classList.remove("is-dragging");
			carousel.scrollLeft = target;
		};
		carousel.addEventListener("pointerup", endDrag);
		carousel.addEventListener("pointercancel", endDrag);

		carousel.addEventListener("keydown", (e) => {
			if (e.key === "ArrowRight") next?.click();
			if (e.key === "ArrowLeft") prev?.click();
		});

		/* Booster piloté par le scroll : il arrive, tremble, se déchire puis distribue les cartes.
		   La scène reste collée à l'écran ; remonter la page range les cartes dans le sachet. */
		const section = document.querySelector<HTMLElement>(".projects");
		const stage = carousel.closest<HTMLElement>(".carousel-stage");
		const booster = stage?.querySelector<HTMLElement>(".booster");
		if (!reducedMotion && section && stage && booster && items.length) {
			const top = booster.querySelector(".booster-top")!;
			const flash = booster.querySelector(".booster-flash")!;
			const footer = section.querySelector(".projects-footer")!;

			stage.classList.add("has-booster", "is-opening");
			carousel.scrollLeft = 0;
			gsap.set(booster, { xPercent: -50, yPercent: -50 });

			// Écart entre le centre du sachet et la place finale d'une carte (mesures de mise en page, sans transformations)
			const dx = (item: HTMLElement) => booster.offsetLeft - (item.offsetLeft + item.offsetWidth / 2);
			const dy = (item: HTMLElement) => booster.offsetTop - (item.offsetTop + item.offsetHeight / 2);
			const rise = () => booster.offsetHeight * 0.85;

			// Le carrousel ne redevient manipulable qu'une fois toutes les cartes posées
			let dealt = false;
			const setDealt = (value: boolean) => {
				if (value === dealt) return;
				dealt = value;
				stage.classList.toggle("is-opening", !value);
				if (!value) carousel.scrollLeft = 0;
				updateCarousel();
			};

			const tl = gsap.timeline({
				defaults: { ease: "none" },
				onUpdate: () => setDealt(tl.progress() === 1),
				scrollTrigger: { trigger: section, start: "top top", end: "bottom bottom", scrub: 0.8, invalidateOnRefresh: true },
			});

			tl.fromTo(
				booster,
				{ autoAlpha: 0, y: 260, scale: 0.6, rotate: -18 },
				{ autoAlpha: 1, y: 0, scale: 1, rotate: 0, duration: 1, ease: "power2.out" },
			)
				.to(booster, { keyframes: { rotate: [0, -5, 5, -5, 5, -3, 0], scale: [1, 1.02, 1.03, 1.05, 1.06, 1.07, 1.08] }, duration: 0.8 })
				.addLabel("tear")
				.to(top, { x: 150, y: -110, rotate: 32, autoAlpha: 0, duration: 0.8, ease: "power2.out" }, "tear")
				.fromTo(flash, { scale: 0.2, autoAlpha: 1 }, { scale: 2.2, autoAlpha: 0, duration: 0.8, ease: "power2.out" }, "tear")
				.to(booster, { scale: 1, duration: 0.4 }, "tear")
				.addLabel("deal", "tear+=0.3");

			items.forEach((item, i) => {
				const at = `deal+=${i * 0.45}`;
				// La carte sort du sachet par le haut, puis file vers sa place avec un reflet holographique
				tl.fromTo(
					item,
					{ x: () => dx(item), y: () => dy(item) + 30, scale: 0.42, rotate: gsap.utils.random(-12, 12), autoAlpha: 0 },
					{ y: () => dy(item) - rise(), rotate: gsap.utils.random(-6, 6), autoAlpha: 1, duration: 0.5, ease: "power2.out" },
					at,
				).to(
					item,
					{
						x: 0,
						y: 0,
						scale: 1,
						rotate: 0,
						duration: 1,
						ease: "power3.inOut",
						onStart: () => item.classList.remove("is-foil"),
						onComplete: () => item.classList.add("is-foil"),
						onReverseComplete: () => item.classList.remove("is-foil"),
					},
					`${at}+0.5`,
				);
			});

			// Le sachet vide tombe une fois la dernière carte sortie, puis le bas de section apparaît
			tl.to(
				booster,
				{ y: 220, rotate: -14, scale: 0.8, autoAlpha: 0, duration: 0.8, ease: "power2.in" },
				`deal+=${(items.length - 1) * 0.45 + 0.5}`,
			)
				.fromTo(footer, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" }, ">-0.2")
				.to({}, { duration: 0.6 }); // temps de pause avant de quitter la section
		}
	}

	/* ---------- MA MÉTHODE : la frise défile à l'horizontale ---------- */
	if (!reducedMotion) {
		const method = document.querySelector<HTMLElement>(".method")!;
		const methodTrack = method.querySelector<HTMLElement>(".method-track")!;

		// La scène sombre s'ouvre en grandissant jusqu'aux bords de l'écran
		gsap.fromTo(
			".method-inner",
			{ clipPath: "inset(12% 8% 0% 8%)" },
			{ clipPath: "inset(0% 0% 0% 0%)", ease: "none", scrollTrigger: { trigger: method, start: "top bottom", end: "top top", scrub: true } },
		);

		const mm = gsap.matchMedia();
		mm.add("(min-width: 768px)", () => {
			const distance = () => Math.max(methodTrack.scrollWidth - window.innerWidth, 0);
			// La hauteur de la section correspond à la longueur de la frise à parcourir
			const setHeight = () => (method.style.height = `${window.innerHeight + distance()}px`);
			setHeight();
			ScrollTrigger.addEventListener("refreshInit", setHeight);

			const scroll = gsap.to(methodTrack, {
				x: () => -distance(),
				ease: "none",
				scrollTrigger: { trigger: method, start: "top top", end: "bottom bottom", scrub: 0.8, invalidateOnRefresh: true },
			});
			gsap.to(".method-progress span", {
				scaleX: 1,
				ease: "none",
				scrollTrigger: { trigger: method, start: "top top", end: "bottom bottom", scrub: 0.8 },
			});

			// Les étapes hors écran arrivent inclinées puis se redressent
			method.querySelectorAll<HTMLElement>(".step").forEach((step) => {
				if (step.getBoundingClientRect().left < window.innerWidth) return;
				gsap.from(step, {
					rotate: 8,
					yPercent: 18,
					scale: 0.85,
					opacity: 0.2,
					ease: "power2.out",
					scrollTrigger: { trigger: step, containerAnimation: scroll, start: "left right", end: "left 55%", scrub: true },
				});
			});

			return () => {
				ScrollTrigger.removeEventListener("refreshInit", setHeight);
				method.style.height = "";
			};
		});

		mm.add("(max-width: 767px)", () => {
			method.querySelectorAll<HTMLElement>(".step").forEach((step) => {
				gsap.from(step, {
					y: 60,
					rotate: 3,
					opacity: 0,
					duration: 0.8,
					ease: "power3.out",
					scrollTrigger: { trigger: step, start: "top 88%", once: true },
				});
			});
		});
	}
</script>
