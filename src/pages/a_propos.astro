---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import SkewButton from "../components/SkewButton.astro";
import ContactCta from "../components/ContactCta.astro";
import { Image } from "astro:assets";
import strasbourg from "../assets/a_propos/strasbourg.jpg";
import montbeliard from "../assets/a_propos/montbeliard.jpg";
import crac19 from "../assets/a_propos/crac19.webp";
import afficheVitra from "../assets/a_propos/affiche-vitra.jpg";
import personnage from "../assets/a_propos/personnage.svg";
import bubble from "../assets/bubble.svg";

const facts = [
	{ value: "20 ans", label: "originaire des environs de Strasbourg" },
	{ value: "BUT MMI", label: "3e année à Montbéliard" },
	{ value: "Graphiste", label: "le métier que je vise" },
];

const principles = [
	{
		title: "Épuré",
		text: "Des compositions simples et réfléchies, où chaque élément a une raison d'être. Pas de surcharge visuelle.",
	},
	{
		title: "Lisible",
		text: "Un bon design communique vite : il capte l'attention puis guide naturellement le regard vers l'essentiel.",
	},
	{
		title: "Cohérent",
		text: "Des identités visuelles qui tiennent sur tous les supports et répondent aux besoins de leurs utilisateurs.",
	},
	{
		title: "Impactant",
		text: "Rendre les idées plus claires et plus mémorables, en trouvant l'équilibre entre esthétique et fonction.",
	},
];

const references = [
	{ href: "/projets/ahnq6bhmb0qxbib", src: crac19, type: "Affiche", title: "CRAC 19" },
	{ href: "/projets/4jlqbvb2oz1oqoz", src: afficheVitra, type: "Affiche", title: "Vitra Walls" },
];
---

<Layout
	title="À propos - Titouan Winkel"
	description="Titouan Winkel, 20 ans, étudiant en BUT MMI à Montbéliard et futur graphiste : parcours, approche du design et inspirations."
>
	<main class="overflow-x-clip">
		<!-- HERO -->
		<section class="about-hero relative">
			<div class="about-hero-bg absolute inset-0" aria-hidden="true">
				<div class="about-hero-grid absolute inset-0"></div>
			</div>

			<div class="relative container mx-auto px-4 md:px-6 pt-16 md:pt-24 pb-20 md:pb-28">
				<div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-16 items-center">
					<div class="space-y-6 md:space-y-8">
						<p class="eyebrow" data-hero-in>
							<span class="dot" aria-hidden="true"></span>
							À propos
						</p>
						<h1 class="about-title text-4xl md:text-6xl xl:text-7xl leading-[1.08]">
							<span class="line"><span>Donner du sens</span></span>
							<span class="line"><span>à chaque</span></span>
							<span class="line"><span class="title-highlight text-white">création.</span></span>
						</h1>
						<p class="max-w-xl text-lg md:text-xl leading-relaxed" data-hero-in>
							Étudiant en design graphique, je conçois des identités visuelles, des affiches et des
							interfaces qui allient <strong class="text-grape">créativité, réflexion et communication</strong>.
						</p>
						<div class="flex flex-col sm:flex-row gap-5 sm:gap-8" data-hero-in>
							<SkewButton href="/projets" icon="arrow" variant="primary">Voir mes projets</SkewButton>
							<SkewButton href="/CV_Titouan_Winkel.pdf" download icon="download">Télécharger mon CV</SkewButton>
						</div>
					</div>

					<div class="hero-visual relative mx-auto aspect-square w-full max-w-md">
						<Image src={bubble} alt="" class="hero-bubble absolute inset-0 m-auto w-full h-auto" />
						<svg class="hero-badge" viewBox="0 0 200 200" aria-hidden="true">
							<defs>
								<path id="about-badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
							</defs>
							<circle cx="100" cy="100" r="98" fill="#fff" stroke="#0b0710" stroke-width="4" />
							<text>
								<textPath href="#about-badge-circle">GRAPHISTE ✦ DESIGNER WEB ✦ ILLUSTRATEUR ✦ </textPath>
							</text>
							<text x="100" y="114" text-anchor="middle" class="badge-center">TW</text>
						</svg>
						<Image
							src={personnage}
							alt="Illustration de Titouan"
							class="hero-character relative z-10 mx-auto h-full w-auto"
							loading="eager"
						/>
					</div>
				</div>

				<ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mt-16 md:mt-20" data-reveal data-reveal-stagger>
					{
						facts.map((fact) => (
							<li class="fact">
								<span class="font-heading text-2xl md:text-3xl leading-tight">{fact.value}</span>
								<span class="text-sm md:text-base">{fact.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- QUI SUIS-JE -->
		<section class="container mx-auto px-4 md:px-6 py-16 md:py-24">
			<div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-20 items-center">
				<div>
					<SectionTitle text="Qui suis-je ?" />
					<div class="space-y-5 text-lg md:text-xl leading-relaxed" data-split-words>
						<p>
							Je m'appelle Titouan <strong class="text-grape">Winkel</strong>, j'ai 20 ans et je suis
							actuellement en troisième année de <strong class="text-grape">BUT Métiers du Multimédia et de
							l'Internet</strong> (MMI) à Montbéliard. Originaire des environs de Strasbourg, je me suis
							naturellement orienté vers le design graphique, un domaine qui me permet d'allier créativité,
							réflexion et communication visuelle.
						</p>
						<p>
							Aujourd'hui, mon objectif est de <strong class="text-grape">devenir graphiste</strong> et de
							concevoir des supports de communication qui ont un réel impact : affiches, flyers, identités
							visuelles, logos ou tout autre support permettant de transmettre un message de manière claire
							et efficace.
						</p>
					</div>
				</div>

				<div class="collage relative mx-auto w-full max-w-md">
					<figure class="photo photo-main">
						<Image
							src={strasbourg}
							alt="Vue aérienne de Strasbourg et de sa cathédrale"
							widths={[400, 640]}
							sizes="(min-width: 1024px) 380px, 80vw"
							class="h-full w-full object-cover object-[35%_center]"
						/>
					</figure>
					<figure class="photo photo-small">
						<Image
							src={montbeliard}
							alt="Rue piétonne de Montbéliard décorée de fanions colorés"
							widths={[240, 480]}
							sizes="200px"
							class="h-full w-full object-cover"
						/>
					</figure>
					<span class="collage-tag">Strasbourg ✦ Montbéliard</span>
				</div>
			</div>
		</section>

		<!-- APPROCHE -->
		<section class="approach py-16 md:py-24">
			<div class="container mx-auto px-4 md:px-6">
				<SectionTitle text="Mon approche" />
				<p class="max-w-2xl text-lg md:text-xl leading-relaxed -mt-2 mb-12" data-reveal>
					Mon approche du design est résolument <strong class="text-grape">minimaliste</strong>. Ce qui me
					motive, c'est de trouver le juste équilibre entre esthétique et fonctionnalité.
				</p>
				<ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-reveal data-reveal-stagger>
					{
						principles.map((item, i) => (
							<li class="principle">
								<span class="principle-num">{String(i + 1).padStart(2, "0")}</span>
								<h3 class="text-2xl mt-6 mb-3">{item.title}</h3>
								<p class="leading-relaxed">{item.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- RÉFÉRENCES -->
		<section class="container mx-auto px-4 md:px-6 py-16 md:py-24">
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-20 items-center">
				<div>
					<SectionTitle text="Ce qui me ressemble" />
					<div class="space-y-5 text-lg md:text-xl leading-relaxed" data-reveal>
						<p>
							À travers chacun de mes projets, je cherche à concevoir des identités visuelles cohérentes
							et des supports de communication efficaces, capables de répondre aux besoins de leurs
							utilisateurs tout en affirmant <strong class="text-grape">une identité forte</strong>.
						</p>
						<p>
							Le design est pour moi un moyen de rendre les idées plus lisibles, plus mémorables et plus
							impactantes. Deux réalisations print qui résument bien cette démarche :
						</p>
					</div>
				</div>

				<ul class="grid grid-cols-2 gap-5 md:gap-8" data-reveal data-reveal-stagger>
					{
						references.map((ref) => (
							<li>
								<a href={ref.href} class="reference group block">
									<span class="reference-frame">
										<Image
											src={ref.src}
											alt={`${ref.type} ${ref.title}`}
											widths={[320, 640]}
											sizes="(min-width: 1024px) 300px, 45vw"
											class="reference-img"
										/>
									</span>
									<span class="reference-caption">
										<span class="text-xs uppercase tracking-widest">{ref.type}</span>
										<span class="font-heading text-base md:text-lg leading-tight">{ref.title}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<ContactCta />
	</main>
</Layout>

<style>
	/* ---------- HERO ---------- */
	.about-hero {
		margin-top: calc(-1 * var(--header-h));
		padding-top: var(--header-h);
	}

	.about-hero-bg {
		background: linear-gradient(180deg, #d5b9ff 0%, #e6d5ff 60%, #fff 100%);
	}

	.about-hero-grid {
		background-image:
			linear-gradient(rgb(11 7 16 / 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgb(11 7 16 / 0.07) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 75%);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		background: rgb(255 255 255 / 0.7);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.eyebrow .dot {
		width: 10px;
		height: 10px;
		border-radius: 9999px;
		background: var(--color-grape);
	}

	.about-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.about-title .line > span {
		display: inline-block;
	}

	.title-highlight {
		position: relative;
		z-index: 0;
		padding: 0 0.15em;
		margin-left: -0.05em;
	}

	.title-highlight::before {
		content: "";
		position: absolute;
		inset: 0.1em 0 0.02em;
		z-index: -1;
		background: var(--color-ink);
		transform: skewX(-15deg);
	}

	.hero-badge {
		position: absolute;
		top: 2%;
		right: 2%;
		z-index: 20;
		width: 30%;
		max-width: 130px;
		font-family: var(--font-heading);
		font-size: 15.5px;
		letter-spacing: 0.08em;
		animation: badge-spin 18s linear infinite;
	}

	.hero-badge .badge-center {
		font-size: 40px;
		fill: var(--color-grape);
	}

	@keyframes badge-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.fact {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 18px 20px;
		border: 3px solid var(--color-ink);
		background: #fff;
		box-shadow: var(--shadow-brutal);
	}

	.fact:nth-child(2) {
		background: var(--color-lilac);
	}

	.fact:nth-child(3) {
		background: var(--color-ink);
		color: #fff;
		box-shadow: 6px 6px 0 0 var(--color-iris);
	}

	/* ---------- QUI SUIS-JE ---------- */
	[data-split-words] :global(.word) {
		display: inline;
	}

	.collage {
		aspect-ratio: 4 / 5;
	}

	.photo {
		position: absolute;
		overflow: hidden;
		border: 4px solid var(--color-ink);
		background: var(--color-lilac-soft);
	}

	.photo-main {
		inset: 0 18% 12% 0;
		box-shadow: var(--shadow-brutal-lg);
		transform: rotate(-2deg);
	}

	.photo-small {
		right: 0;
		bottom: 0;
		width: 42%;
		aspect-ratio: 1 / 2;
		box-shadow: 6px 6px 0 0 var(--color-iris);
		transform: rotate(4deg);
	}

	.collage-tag {
		position: absolute;
		left: -8px;
		bottom: 4%;
		z-index: 2;
		padding: 6px 14px;
		border: 3px solid var(--color-ink);
		background: var(--color-lilac);
		font-family: var(--font-heading);
		font-size: 0.85rem;
		transform: rotate(-4deg);
	}

	/* ---------- APPROCHE ---------- */
	.approach {
		border-block: 4px solid var(--color-ink);
		background:
			radial-gradient(circle at 10% 0%, rgb(255 255 255 / 0.6), transparent 40%),
			var(--color-lilac-soft);
	}

	.principle {
		height: 100%;
		padding: 24px;
		border: 3px solid var(--color-ink);
		background: #fff;
		box-shadow: var(--shadow-brutal);
		/* Survol via la propriété translate : transform est réservé à l'animation d'entrée GSAP,
		   une transition CSS dessus la bloquait à mi-course (cartes décalées) */
		transition:
			translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.principle:hover {
		translate: -3px -3px;
		box-shadow: var(--shadow-brutal-lg);
	}

	.principle-num {
		display: inline-block;
		padding: 2px 12px;
		background: var(--color-ink);
		color: #fff;
		font-family: var(--font-heading);
		transform: skewX(-12deg);
	}

	/* ---------- RÉFÉRENCES ---------- */
	.reference-frame {
		display: block;
		overflow: hidden;
		border: 4px solid var(--color-ink);
		background: var(--color-lilac-soft);
		box-shadow: var(--shadow-brutal);
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	li:nth-child(2) .reference-frame {
		transform: translateY(2rem);
	}

	.group:hover .reference-frame,
	.group:focus-visible .reference-frame {
		transform: translate(-3px, -3px) rotate(-1deg);
		box-shadow: var(--shadow-brutal-lg);
	}

	li:nth-child(2) .group:hover .reference-frame {
		transform: translate(-3px, calc(2rem - 3px)) rotate(1deg);
	}

	.reference-img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1.414;
		object-fit: cover;
	}

	.reference-caption {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin-top: 16px;
	}

	li:nth-child(2) .reference-caption {
		margin-top: calc(2rem + 16px);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		// Intro du hero
		gsap.from(".about-title .line > span", { yPercent: 110, duration: 1.1, ease: "power4.out", stagger: 0.12, delay: 0.15 });
		gsap.from("[data-hero-in]", { y: 30, opacity: 0, duration: 0.8, ease: "power3.out", stagger: 0.12, delay: 0.3 });
		gsap.from(".hero-character", { y: 80, opacity: 0, duration: 1.1, ease: "power3.out", delay: 0.4 });
		gsap.fromTo(
			".hero-bubble",
			{ scale: 0.85 },
			{ yPercent: -12, scale: 1.1, ease: "none", scrollTrigger: { trigger: ".about-hero", start: "top top", end: "bottom top", scrub: true } },
		);

		// Texte révélé mot à mot (en conservant les <strong>)
		const textRoot = document.querySelector<HTMLElement>("[data-split-words]");
		if (textRoot) {
			const walker = document.createTreeWalker(textRoot, NodeFilter.SHOW_TEXT);
			const nodes: Text[] = [];
			while (walker.nextNode()) nodes.push(walker.currentNode as Text);
			nodes.forEach((node) => {
				const frag = document.createDocumentFragment();
				node.textContent!.split(/(\s+)/).forEach((part) => {
					if (!part) return;
					if (/^\s+$/.test(part)) frag.append(part);
					else {
						const span = document.createElement("span");
						span.className = "word";
						span.textContent = part;
						frag.append(span);
					}
				});
				node.replaceWith(frag);
			});
			gsap.fromTo(
				textRoot.querySelectorAll(".word"),
				{ opacity: 0.15 },
				{
					opacity: 1,
					stagger: 0.05,
					ease: "none",
					scrollTrigger: { trigger: textRoot, start: "top 95%", end: "bottom 75%", scrub: true },
				},
			);
		}

		// Collage : les photos se posent l'une après l'autre
		gsap.from(".collage .photo, .collage-tag", {
			y: 60,
			opacity: 0,
			rotate: 0,
			duration: 1,
			ease: "power3.out",
			stagger: 0.15,
			scrollTrigger: { trigger: ".collage", start: "top 80%", once: true },
		});

	}
</script>
