---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { Image } from "astro:assets";
import illustrationTravail from "../assets/a_propos/illustration_travail.webp";
import Crac19 from "../assets/a_propos/crac19.webp";
import immeuble from "../assets/a_propos/immeuble.webp";
import PouletsRotis from "../assets/a_propos/nos_poulets_rotis.png";
import personnage from "../assets/a_propos/personnage.svg";
import line1 from "../assets/boutons/line1.svg";
import line2 from "../assets/boutons/line2.svg";
import bubble from "../assets/bubble.svg";
import arrowDown from "../assets/arrow-down.svg";
import SkewButton from "../components/SkewButton.astro";
import arrow from "../assets/arrow.svg";
import spike from "../assets/spike.svg";
---

<Layout title="À propos - Titouan Winkel">
    <main class="min-h-screen pt-32 pb-20">
        <!-- Hero section -->
        <section class="relative max-w-7xl mx-auto px-8 mb-20">
            <!-- Single bubble behind title -->
            <div
                class="absolute top-14 left-2/5 -translate-y-1/2 -translate-x-1/2 z-0"
            >
                <img
                    src={bubble.src || "/placeholder.svg"}
                    alt=""
                    class="w-48 h-48 opacity-60"
                />
            </div>

            <!-- Centered title with decorations -->
            <div class="relative z-10 flex justify-center md:z-60">
                <div class="relative inline-block">
                    <img
                        src={line1.src || "/placeholder.svg"}
                        alt=""
                        class="absolute -top-2 -left-8 w-12 h-12"
                    />
                    <h1
                        class="text-black font-[Russo_One] text-[50px] font-normal leading-normal"
                    >
                        À propos
                    </h1>
                    <img
                        src={line2.src || "/placeholder.svg"}
                        alt=""
                        class="absolute -bottom-2 -right-8 w-12 h-12"
                    />
                </div>
            </div>

            <!-- Arrow down -->
            <div class="flex justify-center mt-50">
                <img
                    src={arrowDown.src || "/placeholder.svg"}
                    alt="Scroll down"
                    class="w-6 h-10"
                />
            </div>
        </section>

        <!-- Enhanced Qui suis-je section with hover effects and better visual hierarchy -->
        <section class="relative max-w-7xl mx-auto px-8 mb-32">
            <SectionTitle text="Qui suis-je ?" />

            <!-- Two-column layout with enhanced spacing -->
            <div class="grid md:grid-cols-2 gap-16 items-center mt-16">
                <!-- Text column with better typography -->
                <div
                    class="space-y-8 order-2 md:order-1"
                    style="font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 400; line-height: 1.8; color: #000;"
                >
                    <p class="text-balance">
                        Je m'appelle Titouan Winkel, j'ai 20 ans et je suis
                        actuellement en troisième année de BUT Métiers du
                        Multimédia et de l'Internet (MMI) à Montbéliard.
                        Originaire des environs de Strasbourg, je me suis
                        naturellement orienté vers le design graphique, un
                        domaine qui me permet d'allier créativité, réflexion et
                        communication visuelle.
                    </p>

                    <p class="text-balance">
                        Aujourd'hui, mon objectif est de devenir graphiste et de
                        concevoir des supports de communication qui ont un réel
                        impact : affiches, flyers, identités visuelles, logos ou
                        tout autre support permettant de transmettre un message
                        de manière claire et efficace. Ce qui me motive, c'est
                        de donner du sens à chaque création en trouvant le juste
                        équilibre entre esthétique et fonctionnalité.
                    </p>
                </div>

                <!-- Images column with enhanced decorative layout -->
                <div class="relative order-1 md:order-2">
                    <!-- Multiple decorative bubbles -->
                    <div
                        class="absolute -top-12 -right-12 z-0 animate-pulse-slow"
                    >
                        <img
                            src={bubble.src || "/placeholder.svg"}
                            alt=""
                            class="w-36 h-36"
                        />
                    </div>

                    <!-- Images grid with enhanced hover effects -->
                    <div class="relative z-10 grid grid-cols-2 gap-6">
                        <!-- Character illustration with enhanced styling -->
                        <div
                            class="row-span-2 flex items-center justify-center bg-gradient-to-br from-purple-100 to-purple-50 rounded-xl p-6 border-4 border-black relative hover:shadow-2xl hover:scale-105 transition-all duration-300 hover:-rotate-1"
                        >
                            <Image
                                src={personnage || "/placeholder.svg"}
                                alt="Character illustration"
                                class="w-auto h-auto max-h-[320px]"
                            />
                        </div>

                        <!-- Building image with hover effect -->
                        <div
                            class="relative overflow-hidden rounded-xl border-2 border-black hover:shadow-xl hover:scale-105 transition-all duration-300 hover:rotate-1 h-40"
                        >
                            <Image
                                src={immeuble || "/placeholder.svg"}
                                alt="Building"
                                class="w-full h-full object-cover"
                            />
                        </div>

                        <!-- Decorative element with bubble -->
                        <div
                            class="flex items-center justify-center bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl border-2 border-black h-40 relative overflow-hidden group"
                        >
                            <Image
                                src={illustrationTravail || "/placeholder.svg"}
                                alt=""
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                            />
                            <div
                                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Enhanced Mes inspirations section with dynamic layout and animations -->
        <section class="relative max-w-7xl mx-auto px-8 mb-32">
            <!-- Decorative floating bubbles -->
            <div class="absolute top-24 left-16 z-0 animate-float">
                <img
                    src={bubble.src || "/placeholder.svg"}
                    alt=""
                    class="w-36 h-36 opacity-25"
                />
            </div>
            <div class="absolute -bottom-12 right-24 z-0 animate-pulse-slow">
                <img
                    src={bubble.src || "/placeholder.svg"}
                    alt=""
                    class="w-32 h-32 opacity-30"
                />
            </div>

            <SectionTitle text="Inspirations & Références" />

            <!-- Two-column layout: images A4 côte à côte -->
            <div class="grid md:grid-cols-2 gap-12 items-start mt-16">
                <!-- Images column: two A4 images côte à côte, affichées en entier -->
                <div class="relative">
                    <div class="relative z-10">
                        <div class="flex flex-col md:flex-row gap-6">
                            <a
                                href="/projets/ahnq6bhmb0qxbib"
                                aria-label="Projet Crac19"
                                class="w-full md:w-1/2 flex justify-center"
                            >
                                <div
                                    class="overflow-hidden rounded-xl border-2 border-black transition-transform duration-300 hover:scale-105 hover:shadow-2xl cursor-pointer"
                                >
                                    <Image
                                        src={Crac19 || "/placeholder.svg"}
                                        alt="Affiche Crac19"
                                        class="w-full h-auto object-contain max-h-[900px]"
                                    />
                                </div>
                            </a>

                            <a
                                href="/projets/6vvegr6tgt6g8ij"
                                aria-label="Projet Stage à la ferme Urban"
                                class="w-full md:w-1/2 flex justify-center"
                            >
                                <div
                                    class="overflow-hidden rounded-xl border-2 border-black transition-transform duration-300 hover:scale-105 hover:shadow-2xl cursor-pointer"
                                >
                                    <Image
                                        src={PouletsRotis || "/placeholder.svg"}
                                        alt="Flyer Nos Poulets Rotis"
                                        class="w-full h-auto object-contain max-h-[900px]"
                                    />
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Text column with enhanced typography -->
                <div
                    class="space-y-8"
                    style="font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 400; line-height: 1.8; color: #000;"
                >
                    <p class="text-balance">
                        Mon approche du design est résolument minimaliste. Je
                        privilégie des compositions simples, épurées et
                        réfléchies, où chaque élément a une raison d'être. Pour
                        moi, un bon design est avant tout un design qui
                        communique rapidement et efficacement, sans surcharge
                        visuelle. J'aime créer des visuels capables de capter
                        l'attention tout en guidant naturellement le regard vers
                        l'essentiel.
                    </p>

                    <p class="text-balance">
                        À travers chacun de mes projets, je cherche à concevoir
                        des identités visuelles cohérentes et des supports de
                        communication efficaces, capables de répondre aux
                        besoins de leurs utilisateurs tout en affirmant une
                        identité forte. Le design est pour moi un moyen de
                        rendre les idées plus lisibles, plus mémorables et plus
                        impactantes.
                    </p>
                </div>
            </div>
        </section>

        <section class="container mx-auto px-4 md:px-4 py-8 md:py-16 md:ml-20">
            <SectionTitle text="Me contacter" />

            <div
                class="flex flex-col md:flex-row justify-between items-start gap-6 md:gap-0 mt-8"
            >
                <div class="space-y-6">
                    <p
                        class="text-base md:text-xl"
                        style="font-family: 'Space Grotesk', sans-serif; font-weight: 400; font-style: normal; line-height: normal; color: #000;"
                    >
                        Intéressé par mon travail, des questions, une offre
                        d'emploi... <span class="text-purple-600 font-semibold"
                            >Contactez moi !</span
                        >
                    </p>
                    <div class="md:mt-15">
                        <SkewButton href="/contact">
                            <div class="flex items-center gap-3">
                                <Image
                                    src={arrow || "/placeholder.svg"}
                                    alt=""
                                    class="w-6 h-6"
                                />
                                <span class="text-sm md:text-base"
                                    >Accéder au formulaire</span
                                >
                            </div>
                        </SkewButton>
                    </div>
                </div>

                <div class="hidden md:block md:-mt-16 md:mr-25">
                    <Image
                        src={spike || "/placeholder.svg"}
                        alt=""
                        class="w-auto h-auto"
                    />
                </div>
            </div>
        </section>
    </main>
</Layout>

<!-- Added custom animations for floating and pulsing effects -->
<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    @keyframes float-delayed {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-15px);
        }
    }

    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(1.05);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    .animate-float-delayed {
        animation: float-delayed 7s ease-in-out infinite;
        animation-delay: 1s;
    }

    .animate-pulse-slow {
        animation: pulse-slow 8s ease-in-out infinite;
    }
</style>
