---
import Layout from "../layouts/Layout.astro";
import SkewButton from "../components/SkewButton.astro";
import { Image } from "astro:assets";
import linkedinLogo from "../assets/logos/web/linkedin.webp";
import behanceLogo from "../assets/logos/web/behance.webp";

const channels = [
	{ label: "E-mail", value: "titouan.winkel@edu.univ-fcomte.fr", href: "mailto:titouan.winkel@edu.univ-fcomte.fr" },
	{ label: "Téléphone", value: "07 62 70 86 34", href: "tel:+33762708634" },
	{ label: "Basé à", value: "Strasbourg, France" },
];

const socials = [
	{ href: "https://www.linkedin.com/in/titouan-winkel-435b25336", label: "LinkedIn", logo: linkedinLogo },
	{ href: "https://www.behance.net/titouanwinkel", label: "Behance", logo: behanceLogo },
];
---

<Layout
	title="Contact - Titouan Winkel"
	description="Contactez Titouan Winkel, graphiste et designer web : formulaire, e-mail, téléphone et réseaux."
>
	<main class="overflow-x-clip">
		<section class="contact-hero relative">
			<div class="contact-hero-bg absolute inset-0" aria-hidden="true">
				<div class="contact-hero-grid absolute inset-0"></div>
			</div>

			<div class="relative container mx-auto px-4 md:px-6 pt-12 md:pt-20 pb-20 md:pb-28">
				<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-start">
					<!-- Colonne d'infos -->
					<div class="space-y-8 md:space-y-10">
						<div class="space-y-6 md:space-y-8">
							<p class="eyebrow" data-hero-in>
								<span class="dot" aria-hidden="true"></span>
								Contact
							</p>
							<h1 class="contact-title text-4xl sm:text-5xl md:text-6xl xl:text-7xl leading-[1.05]">
								<span class="line"><span>Un projet,</span></span>
								<span class="line"><span>une question&nbsp;?</span></span>
								<span class="line"><span class="title-highlight text-white">Écrivez-moi.</span></span>
							</h1>
							<p class="max-w-lg text-lg md:text-xl leading-relaxed" data-hero-in>
								Une offre d'emploi, une collaboration ou simplement un retour sur mon travail&nbsp;:
								je vous réponds dans les meilleurs délais.
							</p>
						</div>

						<ul class="channels" data-hero-in>
							{
								channels.map((c) => (
									<li class="channel">
										<span class="channel-label">{c.label}</span>
										{c.href ? (
											<a href={c.href} class="channel-value channel-link">
												{c.value}
											</a>
										) : (
											<span class="channel-value">{c.value}</span>
										)}
									</li>
								))
							}
						</ul>

						<div class="flex flex-wrap items-center gap-4" data-hero-in>
							{
								socials.map((s) => (
									<a href={s.href} target="_blank" rel="noopener noreferrer" class="social" aria-label={`${s.label} (nouvel onglet)`}>
										<Image src={s.logo} alt="" width={28} height={28} />
										{s.label}
									</a>
								))
							}
							<a href="/CV_Titouan_Winkel.pdf" download class="social">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
									<path d="M12 4v11M6.5 10 12 15.5 17.5 10M5 20h14" stroke-linecap="square"></path>
								</svg>
								Mon CV
							</a>
						</div>
					</div>

					<!-- Formulaire -->
					<div class="form-wrap" data-form-in>
					<div class="form-card">
						<span class="corner corner-tl" aria-hidden="true"></span>
						<span class="corner corner-br" aria-hidden="true"></span>

						<form id="contact-form" class="space-y-5" method="POST" action="https://api.web3forms.com/submit" novalidate>
							<input type="hidden" name="access_key" value="b145046a-7b32-4697-84ab-b5387ccd3e7a" />
							<input type="hidden" name="redirect" value="false" />
							<!-- Piège à robots : invisible pour les humains -->
							<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

							<h2 class="text-2xl md:text-3xl">Envoyer un message</h2>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
								<div class="field">
									<label for="prenom">Prénom</label>
									<input id="prenom" type="text" name="prenom" autocomplete="given-name" required />
								</div>
								<div class="field">
									<label for="nom">Nom</label>
									<input id="nom" type="text" name="nom" autocomplete="family-name" required />
								</div>
							</div>

							<div class="field">
								<label for="email">E-mail</label>
								<input id="email" type="email" name="email" autocomplete="email" required />
							</div>

							<div class="field">
								<label for="sujet">Sujet</label>
								<input id="sujet" type="text" name="sujet" required />
							</div>

							<div class="field">
								<label for="message">Message</label>
								<textarea id="message" name="message" rows="6" required></textarea>
							</div>

							<div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-5 pt-2">
								<p id="form-status" class="form-status" role="status" aria-live="polite"></p>
								<SkewButton type="submit" icon="arrow" variant="primary" id="submit-btn">Envoyer</SkewButton>
							</div>
						</form>
					</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* ---------- HERO ---------- */
	.contact-hero {
		margin-top: calc(-1 * var(--header-h));
		padding-top: var(--header-h);
	}

	.contact-hero-bg {
		background: linear-gradient(180deg, #d5b9ff 0%, #e6d5ff 60%, #fff 100%);
	}

	.contact-hero-grid {
		background-image:
			linear-gradient(rgb(11 7 16 / 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgb(11 7 16 / 0.07) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(ellipse at 30% 30%, #000 20%, transparent 75%);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 14px;
		border: 2px solid var(--color-ink);
		background: rgb(255 255 255 / 0.7);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.eyebrow .dot {
		width: 10px;
		height: 10px;
		border-radius: 9999px;
		background: var(--color-grape);
	}

	.contact-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.contact-title .line > span {
		display: inline-block;
	}

	.title-highlight {
		position: relative;
		z-index: 0;
		padding: 0 0.15em;
		margin-left: -0.05em;
	}

	.title-highlight::before {
		content: "";
		position: absolute;
		inset: 0.1em 0 0.02em;
		z-index: -1;
		background: var(--color-ink);
		transform: skewX(-15deg);
	}

	/* ---------- COORDONNÉES ---------- */
	.channels {
		border-top: 3px solid var(--color-ink);
	}

	.channel {
		display: grid;
		gap: 2px;
		padding: 14px 0;
		border-bottom: 3px solid var(--color-ink);
	}

	@media (min-width: 640px) {
		.channel {
			grid-template-columns: 130px minmax(0, 1fr);
			align-items: baseline;
			gap: 16px;
		}
	}

	.channel-label {
		font-family: var(--font-heading);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		opacity: 0.6;
	}

	.channel-value {
		font-size: 1.1rem;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.channel-link {
		background: linear-gradient(var(--color-iris), var(--color-iris)) 0 100% / 0 3px no-repeat;
		transition:
			background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			color 0.2s ease;
	}

	.channel-link:hover {
		color: var(--color-grape);
		background-size: 100% 3px;
	}

	.social {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 48px;
		padding: 0 16px;
		border: 3px solid var(--color-ink);
		background: #fff;
		font-family: var(--font-heading);
		transition:
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			background-color 0.25s ease;
	}

	.social:hover {
		transform: translate(-2px, -2px);
		background: var(--color-lilac-soft);
		box-shadow: 4px 4px 0 0 var(--color-ink);
	}

	/* ---------- FORMULAIRE ---------- */
	.form-card {
		position: relative;
		padding: 28px 20px;
		border: 3px solid var(--color-ink);
		background: #fff;
	}

	@media (min-width: 768px) {
		.form-card {
			padding: 44px 40px;
		}
	}

	/* Ombre diffuse identique aux cartes projets (sur un parent isolé pour rester derrière la carte) */
	.form-wrap {
		position: relative;
		isolation: isolate;
	}

	.form-wrap::before {
		content: "";
		position: absolute;
		inset: 10% 4% -2% 16%;
		z-index: -1;
		background: linear-gradient(135deg, rgb(11 7 16 / 0.15) 0%, rgb(11 7 16 / 0.55) 60%, var(--color-ink) 100%);
		filter: blur(26px);
		opacity: 0.35;
		transform: translate(14px, 10px);
	}

	.corner {
		position: absolute;
		z-index: 2;
		width: 24px;
		height: 24px;
		border: 8px solid var(--color-ink);
	}

	.corner-tl {
		top: -3px;
		left: -3px;
		border-right: 0;
		border-bottom: 0;
	}

	.corner-br {
		bottom: -3px;
		right: -3px;
		border-left: 0;
		border-top: 0;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-family: var(--font-heading);
		font-size: 0.9rem;
	}

	.field input,
	.field textarea {
		width: 100%;
		padding: 14px 16px;
		border: 3px solid var(--color-ink);
		background: var(--color-lilac-soft);
		font: inherit;
		font-size: 1rem;
		transition:
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.field textarea {
		resize: vertical;
		min-height: 160px;
	}

	.field input:hover,
	.field textarea:hover {
		background: #f3ecff;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		background: #fff;
		box-shadow: 5px 5px 0 0 var(--color-iris);
	}

	.field.is-invalid input,
	.field.is-invalid textarea {
		border-color: #c0262d;
		box-shadow: 5px 5px 0 0 rgb(192 38 45 / 0.35);
	}

	.form-status {
		font-weight: 600;
	}

	.form-status[data-state="loading"] {
		color: var(--color-grape);
	}

	.form-status[data-state="success"] {
		color: #157a3c;
	}

	.form-status[data-state="error"] {
		color: #c0262d;
	}
</style>

<script>
	import { gsap } from "gsap";

	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		gsap.from(".contact-title .line > span", { yPercent: 110, duration: 1.1, ease: "power4.out", stagger: 0.12, delay: 0.15 });
		gsap.from("[data-hero-in]", { y: 30, opacity: 0, duration: 0.8, ease: "power3.out", stagger: 0.1, delay: 0.3 });
		gsap.from("[data-form-in]", { y: 60, opacity: 0, duration: 1, ease: "power3.out", delay: 0.35 });
	}

	const form = document.getElementById("contact-form") as HTMLFormElement;
	const status = document.getElementById("form-status")!;
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

	function setStatus(state: "loading" | "success" | "error" | "", text: string) {
		status.dataset.state = state;
		status.textContent = text;
	}

	// Validation à la sortie de chaque champ, puis en direct une fois l'erreur signalée
	form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not([type=hidden]):not([name=botcheck]), textarea").forEach((field) => {
		const wrapper = field.closest(".field")!;
		field.addEventListener("blur", () => wrapper.classList.toggle("is-invalid", !field.checkValidity()));
		field.addEventListener("input", () => {
			if (wrapper.classList.contains("is-invalid")) wrapper.classList.toggle("is-invalid", !field.checkValidity());
		});
	});

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(".field input, .field textarea")).filter(
			(field) => !field.checkValidity(),
		);
		invalid.forEach((field) => field.closest(".field")!.classList.add("is-invalid"));
		if (invalid.length) {
			setStatus("error", "Merci de remplir correctement tous les champs.");
			invalid[0].focus();
			return;
		}

		submitBtn.disabled = true;
		setStatus("loading", "Envoi en cours…");

		try {
			const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
			const result = await response.json();
			if (!result.success) throw new Error(result.message);
			setStatus("success", "Message envoyé, merci ! Je vous réponds rapidement.");
			form.reset();
		} catch (error) {
			console.error("Échec de l'envoi du formulaire :", error);
			setStatus("error", "L'envoi a échoué. Réessayez ou écrivez-moi directement par e-mail.");
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
