---
import SkewButton from "./SkewButton.astro";
import menuIcon from "../assets/mobile/menu-mobile.svg";
import closeIcon from "../assets/mobile/cross-menu.svg";
import logo from "../assets/logos/logo.svg";
---

<header class="relative z-50 bg-transparent border-b-4 border-black">
    <div class="container mx-auto px-4 sm:px-6 py-3">
        <nav class="flex items-center justify-between">
            <a
                href="/"
                class="flex items-center gap-3 hover:opacity-90 transition-opacity"
            >
                <img
                    src={logo.src || "/placeholder.svg"}
                    alt="TW Logo"
                    class="h-10 w-auto"
                />
                <span
                    class="text-purple-600 text-sm font-semibold"
                    style="font-family: 'Space Grotesk', sans-serif"
                    >Graphiste</span
                >
            </a>

            <div
                class="hidden md:flex items-center text-lg font-bold uppercase gap-10"
            >
                <a
                    href="/projets"
                    class="text-black hover:text-purple-600 transition-colors duration-200"
                    >Projet</a
                >
                <span class="text-black opacity-70">|</span>
                <a
                    href="/a_propos"
                    class="text-black hover:text-purple-600 transition-colors duration-200"
                    >A propos</a
                >
                <span class="text-black opacity-70">|</span>
                <a
                    href="/contact"
                    class="text-black hover:text-purple-600 transition-colors duration-200"
                    >Contact</a
                >
            </div>

            <button
                id="hamburger-btn"
                class="md:hidden p-2"
                aria-label="Toggle menu"
                data-menu-src={menuIcon.src}
                data-close-src={closeIcon.src}
            >
                <img
                    id="hamburger-icon"
                    src={menuIcon.src || "/placeholder.svg"}
                    alt="Menu"
                    class="w-8 h-8"
                />
            </button>
        </nav>
    </div>

    <!-- Mobile menu - simple centered column -->
    <div
        id="mobile-menu"
        class="fixed inset-0 bg-white z-40 transform -translate-y-full transition-transform duration-200 ease-in-out md:hidden"
    >
        <!-- Close button placed in top-right of mobile menu -->
        <button
            id="mobile-close"
            aria-label="Close menu"
            class="absolute top-4 right-4 p-2 z-50"
        >
            <img
                src={closeIcon.src || "/placeholder.svg"}
                alt="Close"
                class="w-8 h-8"
            />
        </button>
        <div
            class="container mx-auto px-6 h-full flex flex-col justify-center items-center gap-6"
        >
            <a
                href="/projets"
                class="text-2xl md:text-3xl font-bold text-black hover:text-purple-600 transition-colors duration-200"
                >Projets</a
            >
            <a
                href="/a_propos"
                class="text-2xl md:text-3xl font-bold text-black hover:text-purple-600 transition-colors duration-200"
                >A propos</a
            >
            <a
                href="/contact"
                class="text-2xl md:text-3xl font-bold text-black hover:text-purple-600 transition-colors duration-200"
                >Contact</a
            >
        </div>
    </div>
</header>

<!-- Vertical purple gradient that descends from the bottom of the header -->
<div
    aria-hidden="true"
    class="w-full pointer-events-none"
    style="height:64px; background: linear-gradient(to bottom, rgba(168,85,247,0.18) 0%, rgba(165,105,255,0.06) 40%, rgba(165,105,255,0.02) 70%, transparent 100%); margin-bottom: -64px;"
>
</div>

<script>
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    /** @type {HTMLImageElement | null} */
    const hamburgerIcon = document.getElementById("hamburger-icon");
    let isOpen = false;

    function toggleMenu() {
        isOpen = !isOpen;
        const menuSrc =
            hamburgerBtn?.getAttribute("data-menu-src") || "/placeholder.svg";
        const closeSrc =
            hamburgerBtn?.getAttribute("data-close-src") || "/placeholder.svg";
        if (isOpen) {
            mobileMenu?.classList.remove("-translate-y-full");
            mobileMenu?.classList.add("translate-y-0");
            if (hamburgerIcon) hamburgerIcon.setAttribute("src", closeSrc);
            document.body.style.overflow = "hidden";
        } else {
            mobileMenu?.classList.remove("translate-y-0");
            mobileMenu?.classList.add("-translate-y-full");
            if (hamburgerIcon) hamburgerIcon.setAttribute("src", menuSrc);
            document.body.style.overflow = "";
        }
        window.dispatchEvent(
            new CustomEvent("mobileMenuToggle", { detail: { isOpen } }),
        );
    }

    hamburgerBtn?.addEventListener("click", toggleMenu);
    const mobileCloseBtn = document.getElementById("mobile-close");
    mobileCloseBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        if (isOpen) toggleMenu();
    });
</script>
