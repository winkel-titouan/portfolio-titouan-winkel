---
import menuIcon from "../assets/mobile/menu-mobile.svg";
import closeIcon from "../assets/mobile/cross-menu.svg";
import logo from "../assets/logos/logo.svg";

const links = [
    { href: "/projets", label: "Projets" },
    { href: "/a_propos", label: "À propos" },
    { href: "/contact", label: "Contact" },
];
// Sur ordinateur, Contact est mis en avant sous forme de bouton
const navLinks = links.filter((link) => link.href !== "/contact");

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header id="site-header" class="site-header sticky top-0 z-50">
    <!-- Le flou est sur un calque séparé : un backdrop-filter sur le header
         casserait le positionnement fixed du menu mobile. -->
    <div class="header-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container mx-auto px-4 sm:px-6 py-4">
        <nav class="flex h-12 items-center justify-between" aria-label="Navigation principale">
            <a href="/" class="group flex items-center gap-3">
                <img
                    src={logo.src}
                    alt="Titouan Winkel - accueil"
                    class="h-10 w-auto transition-transform duration-300 group-hover:-rotate-6"
                />
                <span class="brand-text flex flex-col leading-tight">
                    <span class="font-heading text-base">Titouan Winkel</span>
                    <span class="text-grape text-xs sm:text-sm font-semibold">Graphiste &amp; designer web</span>
                </span>
            </a>

            <div class="hidden lg:flex items-center gap-10">
                <ul class="flex items-center text-lg uppercase gap-8 font-heading">
                    {
                        navLinks.map((link, i) => (
                            <li class="flex items-center gap-8">
                                {i > 0 && <span class="opacity-40" aria-hidden="true">/</span>}
                                <a
                                    href={link.href}
                                    class:list={["nav-link", { "is-active": isActive(link.href) }]}
                                    aria-current={isActive(link.href) ? "page" : undefined}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
                <a
                    href="/contact"
                    class:list={["nav-cta", { "is-active": isActive("/contact") }]}
                    aria-current={isActive("/contact") ? "page" : undefined}
                >
                    <span class="nav-cta-label">
                        Contact
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                            <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square"></path>
                        </svg>
                    </span>
                </a>
            </div>

            <button
                id="hamburger-btn"
                class="lg:hidden p-2"
                aria-label="Ouvrir le menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <img src={menuIcon.src} alt="" class="w-8 h-8" />
            </button>
        </nav>
    </div>

    <div
        id="mobile-menu"
        class="mobile-menu fixed inset-0 z-40 bg-lilac lg:hidden"
        aria-hidden="true"
    >
        <button id="mobile-close" aria-label="Fermer le menu" class="absolute top-4 right-4 p-2">
            <img src={closeIcon.src} alt="" class="w-8 h-8" />
        </button>
        <div class="h-full flex flex-col justify-between px-6 pt-28 pb-10">
            <ul class="flex flex-col gap-6">
                {
                    links.map((link, i) => (
                        <li class="mobile-link" style={`--i:${i}`}>
                            <a
                                href={link.href}
                                class:list={["mobile-nav-link", { "is-active": isActive(link.href) }]}
                                aria-current={isActive(link.href) ? "page" : undefined}
                            >
                                <span class="mobile-nav-num">{String(i + 1).padStart(2, "0")}</span>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <div class="mobile-link mobile-footer" style={`--i:${links.length}`}>
                <p class="font-heading text-lg">Titouan Winkel</p>
                <p class="text-sm mb-5">Graphiste &amp; designer web</p>
                <a href="/CV_Titouan_Winkel.pdf" download class="mobile-cv">
                    Télécharger mon CV
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                        <path d="M12 4v11M6.5 10 12 15.5 17.5 10M5 20h14" stroke-linecap="square"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    .site-header {
        border-bottom: 4px solid var(--color-ink);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .header-bg {
        background: rgb(255 255 255 / 0);
        transition: background-color 0.3s ease;
    }

    .site-header.is-scrolled .header-bg {
        background: rgb(255 255 255 / 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .nav-link {
        position: relative;
        transition: color 0.2s ease;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -6px;
        height: 4px;
        background: var(--color-iris);
        transform: scaleX(0) skewX(-15deg);
        transform-origin: right;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-link:hover,
    .nav-link.is-active {
        color: var(--color-grape);
    }

    .nav-link:hover::after,
    .nav-link.is-active::after {
        transform: scaleX(1) skewX(-15deg);
        transform-origin: left;
    }

    /* Bouton Contact incliné, dans l'esprit des SkewButton */
    .nav-cta {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 20px;
        border: 3px solid var(--color-ink);
        background: var(--color-ink);
        color: #fff;
        font-family: var(--font-heading);
        text-transform: uppercase;
        transform: skewX(-12deg);
        box-shadow: 4px 4px 0 0 var(--color-iris);
        transition:
            transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            background-color 0.25s ease,
            color 0.25s ease;
    }

    .nav-cta-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transform: skewX(12deg);
    }

    .nav-cta svg {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .nav-cta:hover,
    .nav-cta.is-active {
        background: var(--color-lilac);
        color: var(--color-ink);
        transform: skewX(-12deg) translate(-2px, -2px);
        box-shadow: 6px 6px 0 0 var(--color-ink);
    }

    .nav-cta:hover svg {
        transform: translateX(4px);
    }

    @media (max-width: 400px) {
        .brand-text .font-heading {
            font-size: 0.875rem;
        }
    }

    .mobile-nav-link {
        display: flex;
        align-items: baseline;
        gap: 14px;
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 12vw, 3.5rem);
        line-height: 1;
        transition: color 0.2s ease;
    }

    .mobile-nav-link.is-active,
    .mobile-nav-link:hover {
        color: var(--color-grape);
    }

    .mobile-nav-num {
        font-size: 0.9rem;
        opacity: 0.6;
    }

    .mobile-footer {
        padding-top: 24px;
        border-top: 3px solid var(--color-ink);
    }

    .mobile-cv {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        border: 3px solid var(--color-ink);
        background: var(--color-ink);
        color: #fff;
        font-family: var(--font-heading);
        box-shadow: 4px 4px 0 0 #fff;
    }

    .mobile-menu {
        clip-path: circle(0% at calc(100% - 2.5rem) 2.5rem);
        visibility: hidden;
        transition:
            clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1),
            visibility 0s linear 0.6s;
    }

    .mobile-menu.is-open {
        clip-path: circle(150% at calc(100% - 2.5rem) 2.5rem);
        visibility: visible;
        transition: clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1);
    }

    .mobile-link {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease;
    }

    .mobile-menu.is-open .mobile-link {
        opacity: 1;
        transform: none;
        transition-delay: calc(0.25s + var(--i) * 0.08s);
    }
</style>

<script>
    const header = document.getElementById("site-header")!;

    // Les heros remontent sous le header de --header-h : on garde la variable exacte
    new ResizeObserver(() => {
        document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
    }).observe(header);
    const menu = document.getElementById("mobile-menu")!;
    const openBtn = document.getElementById("hamburger-btn")!;
    const closeBtn = document.getElementById("mobile-close")!;
    let isOpen = false;

    function setMenu(open: boolean) {
        isOpen = open;
        menu.classList.toggle("is-open", open);
        menu.setAttribute("aria-hidden", String(!open));
        openBtn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        window.dispatchEvent(new CustomEvent("mobileMenuToggle", { detail: { isOpen: open } }));
    }

    openBtn.addEventListener("click", () => setMenu(!isOpen));
    closeBtn.addEventListener("click", () => setMenu(false));
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen) setMenu(false);
    });

    // Fond flouté dès qu'on quitte le haut de page ; header masqué en descendant
    // On ne bascule qu'après un déplacement franc dans un même sens : le défilement fluide
    // produit de petits allers-retours qui faisaient clignoter le header.
    const SCROLL_TOLERANCE = 24;
    let anchorY = window.scrollY;
    let ticking = false;
    function onScroll() {
        const y = window.scrollY;
        header.classList.toggle("is-scrolled", y > 10);

        if (y <= 300 || isOpen) {
            header.classList.remove("is-hidden");
            anchorY = y;
        } else {
            const hidden = header.classList.contains("is-hidden");
            // Le point de référence suit le défilement tant qu'on continue dans le sens courant
            if (hidden ? y > anchorY : y < anchorY) anchorY = y;
            if (!hidden && y - anchorY > SCROLL_TOLERANCE) {
                header.classList.add("is-hidden");
                anchorY = y;
            } else if (hidden && anchorY - y > SCROLL_TOLERANCE) {
                header.classList.remove("is-hidden");
                anchorY = y;
            }
        }
        ticking = false;
    }
    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(onScroll);
            }
        },
        { passive: true },
    );
    onScroll();
</script>
