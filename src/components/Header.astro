---
import menuIcon from "../assets/mobile/menu-mobile.svg";
import closeIcon from "../assets/mobile/cross-menu.svg";
import logo from "../assets/logos/logo.svg";

const links = [
    { href: "/projets", label: "Projets" },
    { href: "/a_propos", label: "A propos" },
    { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header id="site-header" class="site-header sticky top-0 z-50">
    <!-- Le flou est sur un calque séparé : un backdrop-filter sur le header
         casserait le positionnement fixed du menu mobile. -->
    <div class="header-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container mx-auto px-4 sm:px-6 py-4">
        <nav class="flex items-center justify-between" aria-label="Navigation principale">
            <a href="/" class="group flex items-center gap-3">
                <img
                    src={logo.src}
                    alt="Titouan Winkel - accueil"
                    class="h-10 w-auto transition-transform duration-300 group-hover:-rotate-6"
                />
                <span class="text-grape text-sm font-semibold">Graphiste</span>
            </a>

            <ul class="hidden md:flex items-center text-lg uppercase gap-10 font-heading">
                {
                    links.map((link, i) => (
                        <li class="flex items-center gap-10">
                            {i > 0 && <span class="opacity-40" aria-hidden="true">/</span>}
                            <a
                                href={link.href}
                                class:list={["nav-link", { "is-active": isActive(link.href) }]}
                                aria-current={isActive(link.href) ? "page" : undefined}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>

            <button
                id="hamburger-btn"
                class="md:hidden p-2"
                aria-label="Ouvrir le menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <img src={menuIcon.src} alt="" class="w-8 h-8" />
            </button>
        </nav>
    </div>

    <div
        id="mobile-menu"
        class="mobile-menu fixed inset-0 z-40 bg-lilac md:hidden"
        aria-hidden="true"
    >
        <button id="mobile-close" aria-label="Fermer le menu" class="absolute top-4 right-4 p-2">
            <img src={closeIcon.src} alt="" class="w-8 h-8" />
        </button>
        <ul class="h-full flex flex-col justify-center items-center gap-8">
            {
                links.map((link, i) => (
                    <li class="mobile-link" style={`--i:${i}`}>
                        <a href={link.href} class="font-heading text-4xl hover:text-grape transition-colors">
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>

<style>
    .site-header {
        border-bottom: 4px solid var(--color-ink);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .header-bg {
        background: rgb(255 255 255 / 0);
        transition: background-color 0.3s ease;
    }

    .site-header.is-scrolled .header-bg {
        background: rgb(255 255 255 / 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .nav-link {
        position: relative;
        transition: color 0.2s ease;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -6px;
        height: 4px;
        background: var(--color-iris);
        transform: scaleX(0) skewX(-15deg);
        transform-origin: right;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-link:hover,
    .nav-link.is-active {
        color: var(--color-grape);
    }

    .nav-link:hover::after,
    .nav-link.is-active::after {
        transform: scaleX(1) skewX(-15deg);
        transform-origin: left;
    }

    .mobile-menu {
        clip-path: circle(0% at calc(100% - 2.5rem) 2.5rem);
        visibility: hidden;
        transition:
            clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1),
            visibility 0s linear 0.6s;
    }

    .mobile-menu.is-open {
        clip-path: circle(150% at calc(100% - 2.5rem) 2.5rem);
        visibility: visible;
        transition: clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1);
    }

    .mobile-link {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease;
    }

    .mobile-menu.is-open .mobile-link {
        opacity: 1;
        transform: none;
        transition-delay: calc(0.25s + var(--i) * 0.08s);
    }
</style>

<script>
    const header = document.getElementById("site-header")!;
    const menu = document.getElementById("mobile-menu")!;
    const openBtn = document.getElementById("hamburger-btn")!;
    const closeBtn = document.getElementById("mobile-close")!;
    let isOpen = false;

    function setMenu(open: boolean) {
        isOpen = open;
        menu.classList.toggle("is-open", open);
        menu.setAttribute("aria-hidden", String(!open));
        openBtn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        window.dispatchEvent(new CustomEvent("mobileMenuToggle", { detail: { isOpen: open } }));
    }

    openBtn.addEventListener("click", () => setMenu(!isOpen));
    closeBtn.addEventListener("click", () => setMenu(false));
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen) setMenu(false);
    });

    // Fond flouté dès qu'on quitte le haut de page ; header masqué en descendant
    let lastY = window.scrollY;
    let ticking = false;
    function onScroll() {
        const y = window.scrollY;
        header.classList.toggle("is-scrolled", y > 10);
        header.classList.toggle("is-hidden", y > 300 && y > lastY && !isOpen);
        lastY = y;
        ticking = false;
    }
    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(onScroll);
            }
        },
        { passive: true },
    );
    onScroll();
</script>
