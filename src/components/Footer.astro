---
import linkedinLogo from "../assets/logos/web/linkedin.webp";
import behanceLogo from "../assets/logos/web/behance.webp";

const links = [
    { href: "/projets", label: "Projets" },
    { href: "/a_propos", label: "A propos" },
    { href: "/contact", label: "Contact" },
];

const socials = [
    { href: "https://www.linkedin.com/in/titouan-winkel-435b25336", label: "LinkedIn", logo: linkedinLogo },
    { href: "https://www.behance.net/titouanwinkel", label: "Behance", logo: behanceLogo },
];
---

<footer class="bg-ink text-white mt-25 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-12 pt-14 pb-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-10 mb-10">
            <div class="text-center md:text-left">
                <p class="font-heading text-2xl md:text-[32px]">Titouan Winkel</p>
                <p class="text-lilac mt-1">Graphiste &amp; designer web</p>
            </div>

            <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-center md:items-start">
                <nav class="text-center md:text-left" aria-label="Pied de page">
                    <p class="mb-3 font-bold">Navigation</p>
                    <ul class="space-y-2 text-sm">
                        {
                            links.map((link) => (
                                <li>
                                    <a href={link.href} class="hover:text-lilac transition-colors">
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>

                <div class="text-center md:text-left">
                    <p class="mb-3 font-bold">Réseaux sociaux</p>
                    <div class="flex gap-4 justify-center md:justify-start">
                        {
                            socials.map((s) => (
                                <a
                                    href={s.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="transition-transform hover:-translate-y-1"
                                >
                                    <img src={s.logo.src} alt={s.label} class="w-10 h-10" />
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center pt-6 border-t border-white/15 text-sm text-white/80">
            © {new Date().getFullYear()} Titouan Winkel - Tous droits réservés
        </div>
    </div>
</footer>
