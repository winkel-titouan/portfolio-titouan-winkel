---
import line1 from "../assets/boutons/line1.svg";

interface Props {
    text: string;
}

const { text } = Astro.props;
---

<h2 class="mb-8 flex items-start text-[30px] leading-normal" data-section-title>
    <img src={line1.src} alt="" class="-mt-1" aria-hidden="true" data-bracket />
    <span class="-ml-3 overflow-hidden pb-1">
        <span class="inline-block" data-text>{text}</span>
    </span>
</h2>
