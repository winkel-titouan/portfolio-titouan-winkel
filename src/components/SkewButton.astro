---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    text?: string;
    /** Icône affichée dans la case de droite */
    icon?: "arrow" | "download";
    /** primary = fond noir, secondary = fond blanc */
    variant?: "primary" | "secondary";
}

// Les attributs restants (download, target, aria-*…) sont transmis au lien
const { href, text, icon, variant = "secondary", class: className, ...attrs } = Astro.props;
---

<a href={href} class:list={["sk-btn", `sk-btn--${variant}`, className]} {...attrs}>
    <span class="sk-shine" aria-hidden="true"></span>
    <span class="sk-label"><slot>{text}</slot></span>
    {
        icon && (
            <span class="sk-icon" aria-hidden="true">
                {icon === "download" ? (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6">
                        <path d="M12 4v11M6.5 10 12 15.5 17.5 10M5 20h14" stroke-linecap="square" />
                    </svg>
                ) : (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6">
                        <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square" />
                    </svg>
                )}
            </span>
        )
    }
</a>

<style>
    .sk-btn {
        --sk-bg: #fff;
        --sk-fg: var(--color-ink);
        --sk-shadow: var(--color-ink);
        --sk-icon-bg: var(--color-lilac);
        --sk-icon-fg: var(--color-ink);

        position: relative;
        display: inline-flex;
        align-items: stretch;
        width: fit-content;
        height: 56px;
        overflow: hidden;
        border: 3px solid var(--color-ink);
        background: var(--sk-bg);
        color: var(--sk-fg);
        font-family: var(--font-heading);
        font-size: 1rem;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transform: skewX(-12deg);
        box-shadow: 6px 6px 0 0 var(--sk-shadow);
        transition:
            transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .sk-btn--primary {
        --sk-bg: var(--color-ink);
        --sk-fg: #fff;
        --sk-shadow: var(--color-iris);
        --sk-icon-bg: var(--color-iris);
        --sk-icon-fg: var(--color-ink);
    }

    .sk-btn:hover {
        transform: skewX(-12deg) translate(-3px, -3px);
        box-shadow: 9px 9px 0 0 var(--sk-shadow);
    }

    .sk-btn:active {
        transform: skewX(-12deg) translate(6px, 6px);
        box-shadow: 0 0 0 0 var(--sk-shadow);
        transition-duration: 0.08s;
    }

    /* Le contenu est redressé pour rester lisible */
    .sk-label,
    .sk-icon > :global(*) {
        transform: skewX(12deg);
    }

    .sk-label {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 24px;
    }

    .sk-icon {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 56px;
        border-left: 3px solid var(--color-ink);
        background: var(--sk-icon-bg);
        color: var(--sk-icon-fg);
        transition: background-color 0.25s ease;
    }

    .sk-icon svg {
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .sk-btn:hover .sk-icon {
        background: #fff;
    }

    .sk-btn:hover .sk-icon svg {
        transform: skewX(12deg) translateX(4px);
    }

    .sk-btn[download]:hover .sk-icon svg {
        transform: skewX(12deg) translateY(3px);
    }

    /* Reflet qui balaie le bouton au survol */
    .sk-shine {
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.45) 50%, transparent 70%);
        transform: translateX(-120%);
        pointer-events: none;
    }

    .sk-btn--primary .sk-shine {
        background: linear-gradient(100deg, transparent 30%, rgb(213 185 255 / 0.35) 50%, transparent 70%);
    }

    .sk-btn:hover .sk-shine {
        transform: translateX(120%);
        transition: transform 0.7s ease;
    }

    /* Icônes SVG noires passées dans le slot (anciennes pages) : blanches sur fond noir */
    .sk-btn--primary .sk-label :global(img) {
        filter: invert(1);
    }

    @media (max-width: 480px) {
        .sk-btn {
            height: 52px;
            font-size: 0.9rem;
        }

        .sk-label {
            padding: 0 18px;
        }

        .sk-icon {
            width: 50px;
        }
    }
</style>
