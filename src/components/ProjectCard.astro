---
interface Props {
    href: string;
    project: {
        id: string;
        nom: string;
        description?: string;
        created_at?: string;
    };
    imageUrl?: string;
    /** Affiche le bouton « Voir le projet » en bas de la carte */
    showCta?: boolean;
}

const { href, project, imageUrl, showCta = true } = Astro.props;
---

<a
    href={href}
    class="project-card-link group block h-full"
    data-name={(project.nom || "").toLowerCase()}
    data-created={project.created_at}
>
    <article class="project-card relative h-full flex flex-col">
        <span class="corner corner-tl" aria-hidden="true"></span>
        <span class="corner corner-br" aria-hidden="true"></span>

        <div class="card-media relative">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={project.nom}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        class="card-image"
                    />
                ) : (
                    <span class="card-placeholder" aria-hidden="true">
                        {project.nom?.charAt(0)}
                    </span>
                )
            }
        </div>

        <div class="flex flex-1 flex-col items-center text-center gap-3 px-6 pt-5 pb-6">
            <h3 class="text-2xl leading-tight">{project.nom}</h3>
            {project.description && <p class="leading-relaxed line-clamp-3">{project.description}</p>}
            {
                showCta && (
                    <span class="card-cta mt-auto">
                        Voir le projet
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square"></path>
                        </svg>
                    </span>
                )
            }
        </div>

        <span class="card-glare" aria-hidden="true"></span>
    </article>
</a>

<style>
    /* Permet d'animer l'angle du dégradé au survol */
    @property --card-angle {
        syntax: "<angle>";
        initial-value: 353deg;
        inherits: false;
    }

    .project-card {
        --rx: 0deg;
        --ry: 0deg;
        --mx: 50%;
        --my: 50%;
        background: linear-gradient(
            var(--card-angle),
            rgba(234, 221, 255, 0.23) 10.66%,
            #a983e2 67.17%,
            rgba(234, 221, 255, 0.23) 109.64%
        ),
        /* Fond opaque : l'ombre placée derrière ne doit pas transparaître */
        #fff;
        border: 3px solid var(--color-ink);
        transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
        transition:
            --card-angle 0.8s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.35s ease;
    }

    /* Ombre diffuse en dégradé, posée derrière la carte */
    .project-card-link {
        position: relative;
        isolation: isolate;
    }

    .project-card-link::before {
        content: "";
        position: absolute;
        inset: 10% 4% -2% 16%;
        z-index: -1;
        background: linear-gradient(135deg, rgb(11 7 16 / 0.15) 0%, rgb(11 7 16 / 0.55) 60%, var(--color-ink) 100%);
        filter: blur(26px);
        opacity: 0.35;
        transform: translate(14px, 10px);
        transition:
            opacity 0.4s ease,
            transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            filter 0.4s ease;
    }

    .group:hover::before,
    .group:focus-visible::before {
        opacity: 0.5;
        filter: blur(32px);
        transform: translate(22px, 18px);
    }

    .group:hover .project-card,
    .group:focus-visible .project-card {
        --card-angle: 413deg;
        transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(-6px);
    }

    /* Pendant le tilt, on suit la souris sans latence */
    .project-card.is-tilting {
        transition: --card-angle 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Équerres identiques à celles du loader de la scène 3D :
       posées sur la bordure de la carte, elles s'en écartent au survol */
    .corner {
        position: absolute;
        z-index: 2;
        width: 24px;
        height: 24px;
        border: 8px solid var(--color-ink);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .corner-tl {
        top: -3px;
        left: -3px;
        border-right: 0;
        border-bottom: 0;
    }

    .corner-br {
        bottom: -3px;
        right: -3px;
        border-left: 0;
        border-top: 0;
    }

    .group:hover .corner-tl {
        transform: translate(-12px, -12px);
    }

    .group:hover .corner-br {
        transform: translate(12px, 12px);
    }

    .card-media {
        display: grid;
        place-items: center;
        aspect-ratio: 4 / 3;
        margin: 14px 14px 0;
        overflow: hidden;
        border: 3px solid var(--color-ink);
        background:
            radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.45) 70%),
            var(--color-lilac-soft);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .group:hover .card-image {
        transform: scale(1.07);
    }

    .card-placeholder {
        font-family: var(--font-heading);
        font-size: 5rem;
        color: var(--color-iris);
    }

    .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border: 2px solid var(--color-ink);
        background: #fff;
        font-family: var(--font-heading);
        font-size: 0.9rem;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }

    .card-cta svg {
        transition: transform 0.3s ease;
    }

    .group:hover .card-cta {
        background: var(--color-ink);
        color: #fff;
    }

    .group:hover .card-cta svg {
        transform: translateX(4px);
    }

    .card-glare {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / 0.35), transparent 45%);
        opacity: 0;
        transition: opacity 0.3s ease;
        mix-blend-mode: soft-light;
    }

    .group:hover .card-glare {
        opacity: 1;
    }
</style>

<script>
    // Tilt 3D léger qui suit le pointeur (souris uniquement)
    const canTilt =
        matchMedia("(hover: hover) and (pointer: fine)").matches &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (canTilt) {
        document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
            card.addEventListener("pointermove", (e) => {
                const r = card.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width;
                const y = (e.clientY - r.top) / r.height;
                card.classList.add("is-tilting");
                card.style.setProperty("--ry", `${(x - 0.5) * 10}deg`);
                card.style.setProperty("--rx", `${(0.5 - y) * 10}deg`);
                card.style.setProperty("--mx", `${x * 100}%`);
                card.style.setProperty("--my", `${y * 100}%`);
            });
            card.addEventListener("pointerleave", () => {
                card.classList.remove("is-tilting");
                card.style.setProperty("--rx", "0deg");
                card.style.setProperty("--ry", "0deg");
            });
        });
    }
</script>
